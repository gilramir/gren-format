type alias Config =
    { stdout : Stream.Writable Bytes
    , fsPermission : FileSystem.Permission
    , pathToString : Path -> String
    , projectPath : Path
    , outline : Outline
    , removeUnusedImports : Bool
    , progress : Progress
    }


{-| Where per-file progress goes, for the two modes that format files in place.
`Nothing` is the default -- say nothing until the run is over. `Just stdout`
(behind `--show-progress`) names each file *before* the formatter starts on it,
so a multi-second run on a large project visibly makes progress instead of
sitting silent. -}
type alias Progress =
    Maybe (Stream.Writable Bytes)


type Error
    = FailedToFindSources Outline.FindSourceFilesError
    | NothingToFormat
    | ParseFailure { path : Path, error : String }
    | PrettyPrintFailure { path : Path, error : String }
    | OverwriteFailure { path : Path, error : String }
    | ShowReadFailure { path : Path, error : String }
    | CheckReparseFailed { path : Path, error : String }
    | AstMismatchAfterFormat { path : Path, explanation : String }
    | NotIdempotent { path : Path, diff : String }


{-| Read a file and decode its bytes as UTF-8. Maps both an I/O error and
invalid UTF-8 to a `ShowReadFailure`.

Returns **both** forms of the text, because two different questions get asked
of a file and they need different answers:

  - `source` — CRLF normalized to `\n` (`normalizeLineEndings`). This is what
    gets parsed, and it is the field to reach for by default.
  - `raw` — exactly the bytes on disk. Only for asking "is this file already,
    byte for byte, what we would write?", which is a question about the disk
    and cannot be answered from text the defect has been scrubbed out of.

Returning only `source` is what let a CRLF file survive `formatPaths` forever:
`formatFile` compared the formatted output against text CRLF had already been
removed from, so an otherwise-formatted CRLF file compared equal to its own
LF output and was never rewritten. `--show` prints `\n`, and in-place has to
land what `--show` prints, so line endings are formatting like anything else.
The project run never had the bug only because `Outline.findSourceFiles` hands
it the raw source and it normalizes locally, keeping both -- which is the shape
this function now has too, so the two read paths agree by construction rather
than by each remembering to.

Normalizing at the read boundary — rather than chasing a stray `\r`
per-construct — is what makes the AST-equivalence check meaningful. Every
construct is emitted fresh by the renderer with plain `\n` and never copied
verbatim, except one that DOES copy source text verbatim (a doc comment's
body); the check reparses our own always-`\n` output and compares it against
the original parse, so an original parse still carrying a source `\r` would
make the formatter's own no-op look like an AST-changing edit. -}
readSource : FileSystem.Permission -> Path -> Task Error { raw : String, source : String }
readSource fsPermission path =
    FileSystem.readFile fsPermission path
        |> Task.mapError (\fsErr -> ShowReadFailure { path = path, error = FileSystem.errorToString fsErr })
        |> Task.andThen
            (\bytes ->
                when Bytes.toString bytes is
                    Nothing ->
                        Task.fail (ShowReadFailure { path = path, error = "File content is not valid UTF-8" })

                    Just raw ->
                        Task.succeed { raw = raw, source = normalizeLineEndings raw }
            )


{-| The one line-ending rule, in one place, because there are two ways a
source string reaches the formatter: `readSource` (every single-file flag and
every positional path argument) and `Outline.findSourceFiles` (the no-argument
project run, which reads the files itself).

Only the first normalized, so a CRLF project failed the no-argument run
outright -- a doc comment's body is copied verbatim from source, so the
original parse carried a `\r` the reparsed output did not, and the
AST-equivalence check called the formatter's own no-op an AST-changing edit.
The mode most people run was the one mode no gate covered. -}
normalizeLineEndings : String -> String
normalizeLineEndings source =
    String.replace "\r\n" "\n" source


{-| Is what is on disk already, byte for byte, what formatting would write?

Asked of the RAW bytes, never of the normalized text. A file whose only defect
is its line endings still has to be rewritten: `--show` prints it with `\n`,
and an in-place run has to land exactly what `--show` prints, so line endings
are formatting like anything else. Compared against normalized text such a file
comes out equal to its own output and keeps its `\r`s forever -- which is the
bug `formatPaths` had for as long as `readSource` returned only the normalized
form and left its callers nothing else to ask.

One function because all three modes that need the answer -- the project run,
the path-argument run, and `--diff` -- have to give the same one, or `--diff`
describes a write that does not happen.
-}
isAlreadyFormatted : { raw : String, pretty : String } -> Bool
isAlreadyFormatted { raw, pretty } =
    pretty ++ "\n" == raw


{-| Parse module source into its AST and trailing parse `Context`
(comments/positions). `wrapError` builds the `Error` on failure — `ParseFailure`
for original source, `CheckReparseFailed` when reparsing our own formatted output. -}
parseModule : ({ path : Path, error : String } -> Error) -> Path -> String -> Result Error { ast : Src.Module, payload : Context.Context }
parseModule wrapError path source =
    let
        parser =
            Parser.succeed (\ast payload -> { ast = ast, payload = payload })
                |> Parser.keep PM.parser
                |> Parser.keep Parser.getPayload
    in
    when Parser.run parser Context.empty source is
        Err errs ->
            Err (wrapError { path = path, error = PM.errorsToString source errs })

        Ok result ->
            Ok result


{-| Build the Logical Printing Tree and render it to the canonical formatted
string, mapping any formatter failure to `PrettyPrintFailure`. -}
renderModule : Path -> Src.Module -> Context.Context -> Result Error String
renderModule path module_ context =
    let
        wrapErr errString =
            PrettyPrintFailure { path = path, error = errString }
    in
    makeLogicalPrintingTree module_ context
        |> Result.mapError wrapErr
        |> Result.andThen (\lpt -> renderRoot lpt |> Result.mapError wrapErr)


{-| Full format-and-verify pipeline:
  parse → [optionally remove unused imports] → format1 → reparse → AST compare → format2 → idempotency compare.
  Returns the canonical formatted string on success.
-}
formatAndVerify : Bool -> Path -> String -> Result Error String
formatAndVerify doRemoveUnusedImports path source =
    parseModule ParseFailure path source
        |> Result.andThen
            (\{ ast = ast1, payload = payload1 } ->
                let
                    transformed =
                        if doRemoveUnusedImports then
                            RUI.removeUnusedImports ast1 payload1

                        else
                            { module_ = ast1, context = payload1 }
                in
                renderModule path transformed.module_ transformed.context
                    |> Result.andThen (verifyReparse path transformed.module_)
            )


{-| Format once and return the output *without* the reparse/idempotency check —
i.e. the raw `pretty1` that `formatAndVerify` would compare against `pretty2`.
Debug aid (behind `--show-first`) for inspecting a non-idempotent first format. -}
formatFirst : Bool -> Path -> String -> Result Error String
formatFirst doRemoveUnusedImports path source =
    parseModule ParseFailure path source
        |> Result.andThen
            (\{ ast = ast1, payload = payload1 } ->
                let
                    transformed =
                        if doRemoveUnusedImports then
                            RUI.removeUnusedImports ast1 payload1

                        else
                            { module_ = ast1, context = payload1 }
                in
                renderModule path transformed.module_ transformed.context
            )


{-| Reparse the formatted output, confirm its AST matches the original, and
confirm re-formatting is a fixed point (idempotency). Returns `pretty1`. -}
verifyReparse : Path -> Src.Module -> String -> Result Error String
verifyReparse path originalModule pretty1 =
    parseModule CheckReparseFailed path pretty1
        |> Result.andThen
            (\{ ast = ast2, payload = payload2 } ->
                AstCompare.compareModules originalModule ast2
                    |> Result.mapError (\explanation -> AstMismatchAfterFormat { path = path, explanation = explanation })
                    |> Result.andThen (\_ -> renderModule path ast2 payload2)
                    |> Result.andThen
                        (\pretty2 ->
                            if pretty1 == pretty2 then
                                Ok pretty1

                            else
                                Err (NotIdempotent { path = path, diff = unifiedDiffStrings pretty1 pretty2 })
                        )
            )


{-| What one path argument turned into: the files to format, and the symbolic
links passed over on the way.

The links are carried out rather than reported here because expanding a path is
a question, not an announcement -- the two callers already own an output stream
and print in their own voice. -}
type alias Expansion =
    { files : Array Path
    , skippedLinks : Array Path
    }


{-| Expand a path argument to the files to format.
    If the path is a directory, returns the Gren source files directly in it --
    or, with `recurse`, those in it and in every directory below it. A Gren
    source file has a `.gren` extension and a name starting with a capital ASCII
    letter.
    A regular file returns itself: a named file is formatted whatever it is
    called, since naming it is already the intent that the directory filter has
    to infer.
    A symlink returns nothing, and is reported as skipped -- see
    `skippedLinkNote`.
-}
expandPathToFiles : FileSystem.Permission -> { recurse : Bool } -> Path -> Task Error Expansion
expandPathToFiles fsPermission options path =
    FileSystem.metadata fsPermission { resolveLink = False } path
        |> Task.mapError (\fsErr -> ShowReadFailure { path = path, error = FileSystem.errorToString fsErr })
        |> Task.andThen
            (\meta ->
                when meta.entityType is
                    FileSystem.Directory ->
                        expandDirectory fsPermission options path
                            |> Task.map (\files -> { files = files, skippedLinks = [] })

                    FileSystem.Symlink ->
                        Task.succeed { files = [], skippedLinks = [ path ] }

                    _ ->
                        Task.succeed { files = [ path ], skippedLinks = [] }
            )


{-| Why a named symlink is skipped rather than formatted.

There is no way to write one. `atomicWrite` renames the formatted text onto the
path, which replaces the link with a regular file and leaves the target holding
the text it had -- turning a link into a copy behind the author's back. Writing
*through* the link instead would silently reformat a file somewhere else in the
tree, which a path argument is not permission to do either. So a link is passed
over, whether it points at a file, at a directory, or at nothing.

It is said out loud, on stderr, because the run was explicitly asked to format
this path: doing nothing quietly reads exactly like doing it. The run itself
still succeeds -- a `gren-format *.gren` that happens to sweep up one link
should not fail on it. -}
skippedLinkNote : Path -> String
skippedLinkNote path =
    Path.toPosixString path ++ ": skipped (symbolic link)"


{-| Say what was passed over, then hand on the files that were not. -}
noteSkippedLinks : Stream.Writable Bytes -> Expansion -> Task Error (Array Path)
noteSkippedLinks notes expansion =
    Array.foldl
        (\link task -> Task.andThen (\_ -> Stream.Log.line notes (skippedLinkNote link)) task)
        (Task.succeed {})
        expansion.skippedLinks
        |> Task.map (\_ -> expansion.files)


{-| One directory's Gren source files, plus -- under `recurse` -- those of every
directory below it, depth-first in listing order.

The recursion is the whole of `-r`; without it this is one `listDirectory` and
the same filter the flag-less form has always applied. -}
expandDirectory : FileSystem.Permission -> { recurse : Bool } -> Path -> Task Error (Array Path)
expandDirectory fsPermission options dir =
    FileSystem.listDirectory fsPermission dir
        |> Task.mapError (\fsErr -> ShowReadFailure { path = dir, error = FileSystem.errorToString fsErr })
        |> Task.andThen
            (\entries ->
                let
                    files =
                        entries
                            |> Array.keepIf (\e -> e.entityType == FileSystem.File)
                            |> Array.keepIf (\e -> e.path.extension == "gren")
                            |> Array.keepIf (\e -> isGrenSourceName e.path.filename)
                            |> Array.map (\e -> Path.prepend dir e.path)

                    subdirectories =
                        if options.recurse then
                            entries
                                |> Array.keepIf (\e -> e.entityType == FileSystem.Directory)
                                |> Array.keepIf (\e -> isWalkableDirectory e.path.filename)
                                |> Array.map (\e -> Path.prepend dir e.path)

                        else
                            []
                in
                Array.foldl
                    (\subdirectory task ->
                        task
                            |> Task.andThen
                                (\found ->
                                    expandDirectory fsPermission options subdirectory
                                        |> Task.map (\deeper -> found ++ deeper)
                                )
                    )
                    (Task.succeed files)
                    subdirectories
            )


{-| Does a recursive walk descend into this directory?

Not into a dotted one -- `.git`, `.gren`, `.devbox` hold version control and
build state, never source anybody meant to format -- and not into
`node_modules` or `gren_packages`, which hold *other people's* Gren source.
Without that last pair, `gren-format -r .` in a project root would rewrite every
dependency the project has installed, which is both a surprise and a diff nobody
can review. The no-argument project run has never had this problem: it takes its
file list from `gren.json`'s source directories rather than from the tree. -}
isWalkableDirectory : String -> Bool
isWalkableDirectory name =
    not (String.startsWith "." name)
        && name /= "node_modules"
        && name /= "gren_packages"


isGrenSourceName : String -> Bool
isGrenSourceName name =
    when String.popFirst name is
        Just { first } ->
            Char.isUpper first

        Nothing ->
            False


{-| Atomically overwrite a single file with its formatted content.
    Writes to <file>.tmp then renames onto the original.
-}
atomicWrite : FileSystem.Permission -> Path -> String -> Task Error {}
atomicWrite fsPermission path pretty =
    let
        tmpPath =
            { path | extension = "tmp" }
    in
    FileSystem.writeFile fsPermission (Bytes.fromString (pretty ++ "\n")) tmpPath
        |> Task.mapError (\fsErr -> OverwriteFailure { path = path, error = FileSystem.errorToString fsErr })
        |> Task.andThen
            (\_ ->
                FileSystem.move fsPermission path tmpPath
                    |> Task.mapError (\fsErr -> OverwriteFailure { path = path, error = FileSystem.errorToString fsErr })
            )
        |> Task.map (\_ -> {})


{-| Print the file's name with **no newline** and nothing after it, then flush,
so the name is on screen for as long as that file is being parsed and
formatted. `progressEnd` closes the line with the outcome. -}
progressStart : Progress -> String -> Task Error {}
progressStart progress name =
    when progress is
        Nothing ->
            Task.succeed {}

        Just stdout ->
            Stream.Log.string stdout (name ++ " ... ")


{-| Close the line `progressStart` opened, with what became of the file. -}
progressEnd : Progress -> String -> Task Error {}
progressEnd progress outcome =
    when progress is
        Nothing ->
            Task.succeed {}

        Just stdout ->
            Stream.Log.line stdout outcome


{-| Run one file's format task between the two halves of its progress line.

The error path closes the line too, and only then re-fails: a run that stops on
a bad file otherwise leaves that file's name dangling with no outcome, which
reads as "still working on it" -- exactly the ambiguity the flag exists to
remove. The full report still follows on stderr. -}
withProgress : Progress -> String -> (a -> String) -> Task Error a -> Task Error a
withProgress progress name outcomeOf task =
    progressStart progress name
        |> Task.andThen (\_ -> task)
        |> Task.andThen
            (\value ->
                progressEnd progress (outcomeOf value)
                    |> Task.map (\_ -> value)
            )
        |> Task.onError
            (\err ->
                progressEnd progress (errorOutcome err)
                    |> Task.andThen (\_ -> Task.fail err)
            )


{-| The outcome of a file that came out the other side: it either needed
rewriting or it did not. -}
rewriteOutcome : Bool -> String
rewriteOutcome wasRewritten =
    if wasRewritten then
        "reformatted"

    else
        "already formatted"


{-| The outcome of a file the formatter could not finish -- one short phrase for
the progress line; `prettifyError` has the details. -}
errorOutcome : Error -> String
errorOutcome error =
    when error is
        ParseFailure _ ->
            "parse error"

        ShowReadFailure _ ->
            "read error"

        OverwriteFailure _ ->
            "write error"

        PrettyPrintFailure _ ->
            "format error"

        CheckReparseFailed _ ->
            "format error"

        AstMismatchAfterFormat _ ->
            "format error"

        NotIdempotent _ ->
            "format error"

        FailedToFindSources _ ->
            "error"

        NothingToFormat ->
            "error"


run : Config -> Task Error String
run { fsPermission, pathToString, projectPath, outline, removeUnusedImports, progress } =
    Outline.findSourceFiles fsPermission outline projectPath
        |> Task.mapError FailedToFindSources
        |> Task.andThen
            (\files ->
                let
                    processFn { path, source } previous =
                        Task.andThen
                            (\acc ->
                                if path.extension /= "gren" then
                                    -- Probably kernel code
                                    Task.succeed acc

                                else
                                    let
                                        relPath =
                                            pathRelativeFrom projectPath path

                                        normalized =
                                            normalizeLineEndings source

                                        formatOne =
                                            when formatAndVerify removeUnusedImports relPath normalized is
                                                Err err ->
                                                    Task.fail err

                                                Ok pretty ->
                                                    if isAlreadyFormatted { raw = source, pretty = pretty } then
                                                        Task.succeed False

                                                    else
                                                        atomicWrite fsPermission path pretty
                                                            |> Task.map (\_ -> True)
                                    in
                                    withProgress progress (pathToString relPath) rewriteOutcome formatOne
                                        |> Task.map
                                            (\wasRewritten ->
                                                if wasRewritten then
                                                    { acc | rewritten = Array.pushLast (pathToString path) acc.rewritten }

                                                else
                                                    { acc | skipped = acc.skipped + 1 }
                                            )
                            )
                            previous

                    reportedProgress =
                        when progress is
                            Just _ ->
                                True

                            Nothing ->
                                False

                    summarize { rewritten, skipped } =
                        let
                            -- With `--show-progress` every one of these paths has
                            -- already been printed, on its own line, next to what
                            -- happened to it; listing them again would just be the
                            -- same names twice.
                            paths =
                                if not reportedProgress && Array.length rewritten > 0 then
                                    String.join "\n" rewritten ++ "\n"

                                else
                                    ""
                        in
                        paths
                            ++ formattedCountSummary
                                { rewritten = Array.length rewritten
                                , skipped = skipped
                                }
                in
                if files == [] then
                    Task.fail NothingToFormat

                else
                    Array.foldl processFn (Task.succeed { rewritten = [], skipped = 0 }) files
                        |> Task.map summarize
            )


{-| Format a single file and overwrite it in place (atomic write).
    Returns True if the file was rewritten, False if it was already formatted.
-}
formatFile : { fsPermission : FileSystem.Permission, removeUnusedImports : Bool } -> Path -> Task Error Bool
formatFile { fsPermission, removeUnusedImports } path =
    readSource fsPermission path
        |> Task.andThen
            (\{ raw, source } ->
                when formatAndVerify removeUnusedImports path source is
                    Err err ->
                        Task.fail err

                    Ok pretty ->
                        if isAlreadyFormatted { raw = raw, pretty = pretty } then
                            Task.succeed False

                        else
                            atomicWrite fsPermission path pretty
                                |> Task.map (\_ -> True)
            )


{-| The line both in-place modes end with: `2 files reformatted, 1 file already
formatted.` Shared so the no-argument project run and the path-argument run
cannot word it differently -- they are the same sentence about the same two
numbers, and they used to build it separately.

Only a count of exactly 1 is singular; `0 files` is right in English and is what
a clean run prints. -}
formattedCountSummary : { rewritten : Int, skipped : Int } -> String
formattedCountSummary { rewritten, skipped } =
    fileCount rewritten ++ " reformatted, " ++ fileCount skipped ++ " already formatted."


fileCount : Int -> String
fileCount n =
    String.fromInt n
        ++ (if n == 1 then
                " file"

            else
                " files"
           )


{-| Format every file reached by the given path arguments — a directory expands
to its Gren source files (`expandPathToFiles`, one level deep unless `recurse`),
any other path is that file — overwriting each in place. Returns how many were
rewritten vs. already formatted. -}
formatPaths : { fsPermission : FileSystem.Permission, notes : Stream.Writable Bytes, removeUnusedImports : Bool, recurse : Bool, progress : Progress } -> Array Path -> Task Error { rewritten : Int, skipped : Int }
formatPaths config paths =
    let
        fileConfig =
            { fsPermission = config.fsPermission
            , removeUnusedImports = config.removeUnusedImports
            }

        formatOne filePath innerTask =
            innerTask
                |> Task.andThen
                    (\counts ->
                        withProgress config.progress (Path.toPosixString filePath) rewriteOutcome (formatFile fileConfig filePath)
                            |> Task.map
                                (\wasRewritten ->
                                    if wasRewritten then
                                        { counts | rewritten = counts.rewritten + 1 }

                                    else
                                        { counts | skipped = counts.skipped + 1 }
                                )
                    )

        expandAndFormat path outerTask =
            outerTask
                |> Task.andThen
                    (\counts ->
                        expandPathToFiles config.fsPermission { recurse = config.recurse } path
                            |> Task.andThen (noteSkippedLinks config.notes)
                            |> Task.andThen (\filePaths -> Array.foldl formatOne (Task.succeed counts) filePaths)
                    )
    in
    Array.foldl expandAndFormat (Task.succeed { rewritten = 0, skipped = 0 }) paths


{-| Split a whole file's contents into its lines. A file that ends in a newline
does not have an empty last line; `String.split "\n"` invents one, and a diff of
two such strings would end every hunk that reaches the end of the file with a
spurious blank context line. -}
contentLines : String -> Array String
contentLines contents =
    let
        lines =
            String.split "\n" contents
    in
    when Array.last lines is
        Just "" ->
            Array.dropLast 1 lines

        _ ->
            lines


{-| Why a file that would be rewritten still produced an empty line diff: the
change is in bytes a line-based diff cannot show. Written with the `\ ` prefix,
the marker unified diff already reserves for notes about a file rather than
about a line, so the output stays unambiguous when it is read as a patch. -}
invisibleChangeNotes : String -> Array String
invisibleChangeNotes source =
    let
        crlf =
            if String.contains "\r\n" source then
                [ "\\ Only the line endings differ (CRLF becomes LF)." ]

            else
                []

        finalNewline =
            if not (String.endsWith "\n" source) then
                [ "\\ No newline at end of file." ]

            else
                []

        notes =
            crlf ++ finalNewline
    in
    if Array.isEmpty notes then
        [ "\\ The change is whitespace a line diff cannot show." ]

    else
        notes


{-| One file's contribution to a `--diff` run: the unified diff of what
formatting would change, or `Nothing` when the file is already formatted -- in
which case nothing at all is printed for it, so a clean run prints nothing.

`name` is the path as the calling mode reports it: relative to the project root
for the no-argument run, as typed for a path argument. The header names the
original `<name>.orig`, a file that does not exist, so that the diff applies to
`<name>` itself.

`raw` is the bytes on disk. Both callers hand over the same thing and ask
`isAlreadyFormatted` the same question their in-place counterparts ask, which
is what keeps `--diff` from ever describing a write that would not happen. -}
diffOfFile : { name : String, raw : String, pretty : String } -> Maybe String
diffOfFile { name, raw, pretty } =
    if isAlreadyFormatted { raw = raw, pretty = pretty } then
        Nothing

    else
        let
            header =
                [ "diff " ++ name ++ ".orig " ++ name
                , "--- " ++ name ++ ".orig"
                , "+++ " ++ name
                ]

            body =
                unifiedDiffArrays
                    (contentLines (normalizeLineEndings raw))
                    (contentLines (pretty ++ "\n"))
        in
        Just
            (String.join "\n"
                (if body == "" then
                    header ++ invisibleChangeNotes raw

                 else
                    header ++ [ body ]
                )
            )


{-| The outcome of a file in a `--diff` run. Nothing is being rewritten, so the
progress line says what *would* happen rather than what did. -}
diffOutcome : Maybe String -> String
diffOutcome maybeDiff =
    when maybeDiff is
        Just _ ->
            "would reformat"

        Nothing ->
            "already formatted"


{-| Print one file's diff, or nothing at all when it has none. -}
emitDiff : Stream.Writable Bytes -> Maybe String -> Task Error {}
emitDiff stdout maybeDiff =
    when maybeDiff is
        Nothing ->
            Task.succeed {}

        Just text ->
            Stream.Log.line stdout text


{-| Read and format a single file without writing it, returning the diff of what
formatting would change (`Nothing` if it would change nothing). -}
diffFile : { fsPermission : FileSystem.Permission, removeUnusedImports : Bool } -> String -> Path -> Task Error (Maybe String)
diffFile { fsPermission, removeUnusedImports } name path =
    readSource fsPermission path
        |> Task.andThen
            (\{ raw, source } ->
                when formatAndVerify removeUnusedImports path source is
                    Err err ->
                        Task.fail err

                    Ok pretty ->
                        Task.succeed (diffOfFile { name = name, raw = raw, pretty = pretty })
            )


{-| `--diff` for path arguments: the same file set `formatPaths` would rewrite --
a directory expands to its Gren source files, one level deep unless `recurse`,
and any other path is that file -- but print each one's unified diff instead of
overwriting it. -}
diffPaths :
    { stdout : Stream.Writable Bytes
    , notes : Stream.Writable Bytes
    , fsPermission : FileSystem.Permission
    , removeUnusedImports : Bool
    , recurse : Bool
    , progress : Progress
    }
    -> Array Path
    -> Task Error {}
diffPaths config paths =
    let
        fileConfig =
            { fsPermission = config.fsPermission
            , removeUnusedImports = config.removeUnusedImports
            }

        diffOne filePath innerTask =
            innerTask
                |> Task.andThen
                    (\_ ->
                        let
                            name =
                                Path.toPosixString filePath
                        in
                        withProgress config.progress name diffOutcome (diffFile fileConfig name filePath)
                            |> Task.andThen (emitDiff config.stdout)
                    )

        expandAndDiff path outerTask =
            outerTask
                |> Task.andThen
                    (\_ ->
                        expandPathToFiles config.fsPermission { recurse = config.recurse } path
                            |> Task.andThen (noteSkippedLinks config.notes)
                            |> Task.andThen (\filePaths -> Array.foldl diffOne (Task.succeed {}) filePaths)
                    )
    in
    Array.foldl expandAndDiff (Task.succeed {}) paths


{-| `--diff` for the no-argument project run: the same file set `run` would
rewrite, but print each one's unified diff instead of overwriting it. -}
diffProject : Config -> Task Error {}
diffProject { stdout, fsPermission, pathToString, projectPath, outline, removeUnusedImports, progress } =
    Outline.findSourceFiles fsPermission outline projectPath
        |> Task.mapError FailedToFindSources
        |> Task.andThen
            (\files ->
                let
                    processFn { path, source } previous =
                        Task.andThen
                            (\_ ->
                                if path.extension /= "gren" then
                                    -- Probably kernel code
                                    Task.succeed {}

                                else
                                    let
                                        relPath =
                                            pathRelativeFrom projectPath path

                                        name =
                                            pathToString relPath

                                        diffOne =
                                            when formatAndVerify removeUnusedImports relPath (normalizeLineEndings source) is
                                                Err err ->
                                                    Task.fail err

                                                Ok pretty ->
                                                    Task.succeed (diffOfFile { name = name, raw = source, pretty = pretty })
                                    in
                                    withProgress progress name diffOutcome diffOne
                                        |> Task.andThen (emitDiff stdout)
                            )
                            previous
                in
                if files == [] then
                    Task.fail NothingToFormat

                else
                    Array.foldl processFn (Task.succeed {}) files
            )


showFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission, removeUnusedImports : Bool } -> Path -> Task Error {}
showFile { stdout, fsPermission, removeUnusedImports } path =
    readSource fsPermission path
        |> Task.andThen
            (\{ source } ->
                when formatAndVerify removeUnusedImports path source is
                    Err err ->
                        Task.fail err

                    Ok pretty ->
                        Stream.Log.line stdout pretty
            )


{-| Like `showFile` but prints the *first* format without the idempotency guard,
so a non-idempotent first pass can be inspected. Debug aid behind `--show-first`. -}
showFirstFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission, removeUnusedImports : Bool } -> Path -> Task Error {}
showFirstFile { stdout, fsPermission, removeUnusedImports } path =
    readSource fsPermission path
        |> Task.andThen
            (\{ source } ->
                when formatFirst removeUnusedImports path source is
                    Err err ->
                        Task.fail err

                    Ok pretty ->
                        Stream.Log.line stdout pretty
            )


preAstFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
preAstFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\{ source } ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { ast, payload } ->
                        let
                            jsonValue =
                                Json.object
                                    [ { key = "module", value = SourceJson.encodeModule ast }
                                    , { key = "context", value = ContextJson.encodeContext payload }
                                    ]
                        in
                        Stream.Log.line stdout (Json.encode 2 jsonValue)
            )


{-| Parse a single file and print only the first parse's `Context` (the comments)
as JSON — the `--pre-ast` output without the `module`
half. Useful for confirming that two environments parse the same bytes to the
same comment positions. -}
preContextFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
preContextFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\{ source } ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { payload } ->
                        Stream.Log.line stdout (Json.encode 2 (ContextJson.encodeContext payload))
            )


postAstFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
postAstFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\{ source } ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { ast = ast1, payload = payload1 } ->
                        when renderModule path ast1 payload1 is
                            Err err ->
                                Task.fail err

                            Ok formatted ->
                                when parseModule CheckReparseFailed path formatted is
                                    Err err ->
                                        Task.fail err

                                    Ok { ast = ast2, payload = payload2 } ->
                                        when AstCompare.compareModules ast1 ast2 is
                                            Err explanation ->
                                                Task.fail (AstMismatchAfterFormat { path = path, explanation = explanation })

                                            Ok {} ->
                                                let
                                                    jsonValue =
                                                        Json.object
                                                            [ { key = "module", value = SourceJson.encodeModule ast2 }
                                                            , { key = "context", value = ContextJson.encodeContext payload2 }
                                                            ]
                                                in
                                                Stream.Log.line stdout (Json.encode 2 jsonValue)
            )


{-| Format a single file, verify the ASTs match, then print only the
formatted file's `Context` (the comment and whitespace stream) as JSON — the
`--post-ast` output without the `module` half. Useful for confirming that
formatting produces the expected comment/blank-line layout without the noise
of the full AST. -}
postContextFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
postContextFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\{ source } ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { ast = ast1, payload = payload1 } ->
                        when renderModule path ast1 payload1 is
                            Err err ->
                                Task.fail err

                            Ok formatted ->
                                when parseModule CheckReparseFailed path formatted is
                                    Err err ->
                                        Task.fail err

                                    Ok { ast = ast2, payload = payload2 } ->
                                        when AstCompare.compareModules ast1 ast2 is
                                            Err explanation ->
                                                Task.fail (AstMismatchAfterFormat { path = path, explanation = explanation })

                                            Ok {} ->
                                                Stream.Log.line stdout (Json.encode 2 (ContextJson.encodeContext payload2))
            )


lptFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
lptFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\{ source } ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { ast, payload } ->
                        when makeLogicalPrintingTree ast payload is
                            Err errString ->
                                Task.fail (PrettyPrintFailure { path = path, error = errString })

                            Ok lpt ->
                                Stream.Log.line stdout (LPTJson.lptToJson lpt)
            )


{-| Print one file's render tree as JSON -- the Logical Printing Tree as the
renderer actually receives it, lowered through `Formatter.RenderTree`.

The tree `--lpt` prints and this one are the same shape, so read them side by
side. What only this one has is the four author-intent booleans `lower`
computes on the way past the stage barrier: they are absent from the LPT and
already consumed by the time there is a `Box` to dump, so `--rt` is the only
place their values are visible. What only `--lpt` has is the source positions,
which is the point of the barrier -- see `Formatter.RenderTree.Json`.
-}
rtFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
rtFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\{ source } ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { ast, payload } ->
                        when makeLogicalPrintingTree ast payload is
                            Err errString ->
                                Task.fail (PrettyPrintFailure { path = path, error = errString })

                            Ok lpt ->
                                Stream.Log.line stdout (RenderTreeJson.renderTreeToJson lpt)
            )


{-| Print the predicate/renderer disagreements in one file as JSON. Each entry is
a layout predicate that promised a hard break the renderer did not emit -- a
class of bug every other check is blind to, because the resulting output is
still deterministic, AST-equivalent and idempotent.
-}
auditPredicatesFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
auditPredicatesFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\{ source } ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { ast, payload } ->
                        when makeLogicalPrintingTree ast payload is
                            Err errString ->
                                Task.fail (PrettyPrintFailure { path = path, error = errString })

                            Ok lpt ->
                                Stream.Log.line stdout
                                    (PredicateAgreement.findingsToJson (PredicateAgreement.auditLpt lpt))
            )


{-| Format the file twice and print, as JSON, which layout *decisions* differed
between the two passes -- not which bytes did.

`--show` already answers "is this a fixed point". It cannot answer "which
decision was not", and with a non-zero residual of known non-idempotent shapes
that second question is the one with a work-list behind it: a byte diff has to
be traced back to a culprit by hand, whereas a flipped decision names itself and
groups with every other finding that flipped the same one.

The two passes here are the same two `verifyReparse` runs -- render, reparse,
render the reparsed AST -- with the AST comparison left out and both Logical
Printing Trees kept. Leaving it out is deliberate: this flag is aimed at files
that are *not* fixed points, and an AST mismatch is a different bug class that
`--show` reports properly.
-}
decisionsFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
decisionsFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\{ source } ->
                when decisionStabilityReport path source is
                    Err err ->
                        Task.fail err

                    Ok report ->
                        Stream.Log.line stdout (DecisionTrace.reportToJson report)
            )


decisionStabilityReport :
    Path
    -> String
    -> Result Error
        { bytesDiffer : Bool
        , flips : Array DecisionTrace.Flip
        , movedDecls : Array String
        , convergedFlips : Int
        , decisionCount : Int
        }
decisionStabilityReport path source =
    let
        wrapErr errString =
            PrettyPrintFailure { path = path, error = errString }

        -- The per-declaration trace and the string the whole file renders to.
        -- `renderModule` gives only the second, and the trace is the point here.
        renderPass ast payload =
            makeLogicalPrintingTree ast payload
                |> Result.mapError wrapErr
                |> Result.andThen
                    (\lpt ->
                        Result.map2
                            (\pretty decls -> { pretty = pretty, decls = decls })
                            (renderRoot lpt)
                            (DecisionTrace.traceDeclarations lpt)
                            |> Result.mapError wrapErr
                    )
    in
    parseModule ParseFailure path source
        |> Result.andThen (\first -> renderPass first.ast first.payload)
        |> Result.andThen
            (\pass1 ->
                parseModule CheckReparseFailed path pass1.pretty
                    |> Result.andThen (\second -> renderPass second.ast second.payload)
                    |> Result.map
                        (\pass2 ->
                            let
                                diff =
                                    DecisionTrace.diffDeclarations pass1.decls pass2.decls
                            in
                            { bytesDiffer = pass1.pretty /= pass2.pretty
                            , flips = diff.flips
                            , movedDecls = diff.movedDecls
                            , convergedFlips = diff.convergedFlips
                            , decisionCount = Array.foldl (\d acc -> acc + Array.length d.decisions) 0 pass1.decls
                            }
                        )
            )


boxFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
boxFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\{ source } ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { ast, payload } ->
                        when makeLogicalPrintingTree ast payload is
                            Err errString ->
                                Task.fail (PrettyPrintFailure { path = path, error = errString })

                            Ok lpt ->
                                when lptToBoxJson lpt is
                                    Err errString ->
                                        Task.fail (PrettyPrintFailure { path = path, error = errString })

                                    Ok json ->
                                        Stream.Log.line stdout json
            )


-- TODO: add to gren-lang/node?
pathRelativeFrom : Path -> Path -> Path
pathRelativeFrom base absolute =
    let
        commonPrefix =
            findCommonPrefix 0 (Array.pushLast base.filename base.directory) absolute.directory
    in
    if commonPrefix > 0 then
        { root = ""
        , directory = Array.dropFirst commonPrefix absolute.directory
        , filename = absolute.filename
        , extension = absolute.extension
        }

    else
        absolute


findCommonPrefix : Int -> Array String -> Array String -> Int
findCommonPrefix count left right =
    when { l = Array.popFirst left, r = Array.popFirst right } is
        { l = Just { first = lFirst, rest = lRest }, r = Just { first = rFirst, rest = rRest } } ->
            if lFirst == rFirst then
                findCommonPrefix (count + 1) lRest rRest

            else
                count

        _ ->
            count


prettifyError : Error -> Report
prettifyError error =
    when error is
        FailedToFindSources fsErr ->
            Report.create
                "COULD NOT FIND SOURCE CODE"
                Nothing
                (PP.verticalBlock
                    [ PP.words "An error occured while I was searching for .gren files in this project."
                    , PP.empty
                    , PP.words "The error is:"
                    , PP.empty
                    , PP.words (ProjectOutline.outlineFindSourcesErrorToString fsErr)
                        |> PP.indent
                    ]
                )

        NothingToFormat ->
            Report.create
                "NOTHING TO FORMAT"
                Nothing
                (PP.words "I can't seem to find any files in this project."
                )

        ParseFailure { path, error = message } ->
            Report.create
                "FAILED TO PARSE"
                (Just path)
                (PP.verticalBlock (Array.map PP.text (String.split "\n" message))
                )

        PrettyPrintFailure { path, error = message } ->
            Report.create
                "FORMATTER INTERNAL ERROR. PLEASE REPORT THIS 'gren-format' BUG."
                (Just path)
                (PP.verticalBlock (Array.map PP.text (String.split "\n" message))
                )

        OverwriteFailure { path, error = message } ->
            Report.create
                "COULD NOT OVERWRITE FILE"
                (Just path)
                (PP.words message)

        AstMismatchAfterFormat { path, explanation } ->
            Report.create
                "AST MISMATCH AFTER FORMATTING"
                (Just path)
                (PP.verticalBlock
                    [ PP.words "The formatter produced output that does not have the same AST as the original. This is a bug in 'gren format'."
                    , PP.empty
                    , PP.words explanation
                    ]
                )

        NotIdempotent { path, diff } ->
            Report.create
                "FORMATTER NOT IDEMPOTENT"
                (Just path)
                (PP.verticalBlock
                    [ PP.words "Formatting the file twice produced different output. This is a bug in 'gren format'."
                    , PP.empty
                    , PP.verticalBlock (Array.map PP.text (String.split "\n" diff))
                    ]
                )

        ShowReadFailure { path, error = message } ->
            Report.create
                "COULD NOT READ FILE"
                (Just path)
                (PP.words message)

        CheckReparseFailed { path, error = message } ->
            Report.create
                "COULD NOT PARSE FORMATTED OUTPUT"
                (Just path)
                (PP.verticalBlock (Array.map PP.text (String.split "\n" message))
                )
