import Bytes exposing (Bytes)
import Char
import Cli.PrettyPrinter as PP
import Cli.Report as Report exposing (Report)
import Compiler.Ast.Compare as AstCompare
import Compiler.Ast.Source as Src
import Compiler.Ast.Source.Json as SourceJson
import Compiler.Outline as Outline exposing (Outline)
import Compiler.Parse.Context as Context
import Compiler.Parse.Context.Json as ContextJson
import Compiler.Parse.Module as PM
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Formatter.Audit.DecisionTrace as DecisionTrace
import Formatter.Audit.PredicateAgreement as PredicateAgreement
import Formatter.Logical exposing (makeLogicalPrintingTree)
import Formatter.Logical.LPTJson as LPTJson
import Formatter.Render exposing (lptToBoxJson, makePrettyResult)
import Json.Encode as Json
import RemoveUnusedImports as RUI
import Stream
import Stream.Log
import String.Parser.Advanced as Parser
import Task exposing (Task)
import Terminal.ProjectOutline as ProjectOutline
import UnifiedDiff exposing (unifiedDiffStrings)


type alias Config =
    { stdout : Stream.Writable Bytes
    , fsPermission : FileSystem.Permission
    , pathToString : Path -> String
    , projectPath : Path
    , outline : Outline
    , removeUnusedImports : Bool
    , progress : Progress
    }


{-| Where per-file progress goes, for the two modes that format files in place.
`Nothing` is the default -- say nothing until the run is over. `Just stdout`
(behind `--show-progress`) names each file *before* the formatter starts on it,
so a multi-second run on a large project visibly makes progress instead of
sitting silent. -}
type alias Progress =
    Maybe (Stream.Writable Bytes)


type Error
    = FailedToFindSources Outline.FindSourceFilesError
    | NothingToFormat
    | ParseFailure { path : Path, error : String }
    | PrettyPrintFailure { path : Path, error : String }
    | OverwriteFailure { path : Path, error : String }
    | ShowReadFailure { path : Path, error : String }
    | CheckReparseFailed { path : Path, error : String }
    | AstMismatchAfterFormat { path : Path, explanation : String }
    | NotIdempotent { path : Path, diff : String }


{-| Read a file and decode its bytes as a UTF-8 source string. Maps both an I/O
error and invalid UTF-8 to a `ShowReadFailure`.

CRLF line endings are normalized to `\n` here (`normalizeLineEndings`), as
they are for the project run, which gets its sources from
`Outline.findSourceFiles` rather than from this function -- the two read
paths have to agree, and for a while they did not. Every other construct is
emitted fresh by the renderer with
plain `\n` and never copied verbatim from source, so a raw `\r` can only reach
formatted output via a construct that DOES copy source text verbatim (a doc
comment's body). Normalizing at the read boundary — rather than chasing that
per-construct — also keeps the AST-equivalence check meaningful: it reparses
our own (always-`\n`) rendered output and compares against the original
parse, so if the original parse still carried a source `\r`, formatting a
CRLF file would look like an AST-changing edit instead of a no-op. -}
readSource : FileSystem.Permission -> Path -> Task Error String
readSource fsPermission path =
    FileSystem.readFile fsPermission path
        |> Task.mapError (\fsErr -> ShowReadFailure { path = path, error = FileSystem.errorToString fsErr })
        |> Task.andThen
            (\bytes ->
                when Bytes.toString bytes is
                    Nothing ->
                        Task.fail (ShowReadFailure { path = path, error = "File content is not valid UTF-8" })

                    Just source ->
                        Task.succeed (normalizeLineEndings source)
            )


{-| The one line-ending rule, in one place, because there are two ways a
source string reaches the formatter: `readSource` (every single-file flag and
every positional path argument) and `Outline.findSourceFiles` (the no-argument
project run, which reads the files itself).

Only the first normalized, so a CRLF project failed the no-argument run
outright -- a doc comment's body is copied verbatim from source, so the
original parse carried a `\r` the reparsed output did not, and the
AST-equivalence check called the formatter's own no-op an AST-changing edit.
The mode most people run was the one mode no gate covered. -}
normalizeLineEndings : String -> String
normalizeLineEndings source =
    String.replace "\r\n" "\n" source


{-| Parse module source into its AST and trailing parse `Context`
(comments/positions). `wrapError` builds the `Error` on failure — `ParseFailure`
for original source, `CheckReparseFailed` when reparsing our own formatted output. -}
parseModule : ({ path : Path, error : String } -> Error) -> Path -> String -> Result Error { ast : Src.Module, payload : Context.Context }
parseModule wrapError path source =
    let
        parser =
            Parser.succeed (\ast payload -> { ast = ast, payload = payload })
                |> Parser.keep PM.parser
                |> Parser.keep Parser.getPayload
    in
    when Parser.run parser Context.empty source is
        Err errs ->
            Err (wrapError { path = path, error = PM.errorsToString source errs })

        Ok result ->
            Ok result


{-| Build the Logical Printing Tree and render it to the canonical formatted
string, mapping any formatter failure to `PrettyPrintFailure`. -}
renderModule : Path -> Src.Module -> Context.Context -> Result Error String
renderModule path module_ context =
    let
        wrapErr errString =
            PrettyPrintFailure { path = path, error = errString }
    in
    makeLogicalPrintingTree module_ context
        |> Result.mapError wrapErr
        |> Result.andThen (\lpt -> makePrettyResult lpt |> Result.mapError wrapErr)


{-| Full format-and-verify pipeline:
  parse → [optionally remove unused imports] → format1 → reparse → AST compare → format2 → idempotency compare.
  Returns the canonical formatted string on success.
-}
formatAndVerify : Bool -> Path -> String -> Result Error String
formatAndVerify doRemoveUnusedImports path source =
    parseModule ParseFailure path source
        |> Result.andThen
            (\{ ast = ast1, payload = payload1 } ->
                let
                    transformed =
                        if doRemoveUnusedImports then
                            RUI.removeUnusedImports ast1 payload1

                        else
                            { module_ = ast1, context = payload1 }
                in
                renderModule path transformed.module_ transformed.context
                    |> Result.andThen (verifyReparse path transformed.module_)
            )


{-| Format once and return the output *without* the reparse/idempotency check —
i.e. the raw `pretty1` that `formatAndVerify` would compare against `pretty2`.
Debug aid (behind `--show-first`) for inspecting a non-idempotent first format. -}
formatFirst : Bool -> Path -> String -> Result Error String
formatFirst doRemoveUnusedImports path source =
    parseModule ParseFailure path source
        |> Result.andThen
            (\{ ast = ast1, payload = payload1 } ->
                let
                    transformed =
                        if doRemoveUnusedImports then
                            RUI.removeUnusedImports ast1 payload1

                        else
                            { module_ = ast1, context = payload1 }
                in
                renderModule path transformed.module_ transformed.context
            )


{-| Reparse the formatted output, confirm its AST matches the original, and
confirm re-formatting is a fixed point (idempotency). Returns `pretty1`. -}
verifyReparse : Path -> Src.Module -> String -> Result Error String
verifyReparse path originalModule pretty1 =
    parseModule CheckReparseFailed path pretty1
        |> Result.andThen
            (\{ ast = ast2, payload = payload2 } ->
                AstCompare.compareModules originalModule ast2
                    |> Result.mapError (\explanation -> AstMismatchAfterFormat { path = path, explanation = explanation })
                    |> Result.andThen (\_ -> renderModule path ast2 payload2)
                    |> Result.andThen
                        (\pretty2 ->
                            if pretty1 == pretty2 then
                                Ok pretty1

                            else
                                Err (NotIdempotent { path = path, diff = unifiedDiffStrings pretty1 pretty2 })
                        )
            )


{-| Expand a path argument to a list of files to format.
    If the path is a directory, returns all Gren source files directly in it
    (non-recursive; symlinks are skipped). A Gren source file has a `.gren`
    extension and a name starting with a capital ASCII letter.
    For any other path type (regular file, symlink, …), returns [path].
-}
expandPathToFiles : FileSystem.Permission -> Path -> Task Error (Array Path)
expandPathToFiles fsPermission path =
    FileSystem.metadata fsPermission { resolveLink = False } path
        |> Task.mapError (\fsErr -> ShowReadFailure { path = path, error = FileSystem.errorToString fsErr })
        |> Task.andThen
            (\meta ->
                if meta.entityType == FileSystem.Directory then
                    FileSystem.listDirectory fsPermission path
                        |> Task.mapError (\fsErr -> ShowReadFailure { path = path, error = FileSystem.errorToString fsErr })
                        |> Task.map
                            (\entries ->
                                entries
                                    |> Array.keepIf (\e -> e.entityType == FileSystem.File)
                                    |> Array.keepIf (\e -> e.path.extension == "gren")
                                    |> Array.keepIf (\e -> isGrenSourceName e.path.filename)
                                    |> Array.map (\e -> Path.prepend path e.path)
                            )

                else
                    Task.succeed [ path ]
            )


isGrenSourceName : String -> Bool
isGrenSourceName name =
    when String.popFirst name is
        Just { first } ->
            Char.isUpper first

        Nothing ->
            False


{-| Atomically overwrite a single file with its formatted content.
    Writes to <file>.tmp then renames onto the original.
-}
atomicWrite : FileSystem.Permission -> Path -> String -> Task Error {}
atomicWrite fsPermission path pretty =
    let
        tmpPath =
            { path | extension = "tmp" }
    in
    FileSystem.writeFile fsPermission (Bytes.fromString (pretty ++ "\n")) tmpPath
        |> Task.mapError (\fsErr -> OverwriteFailure { path = path, error = FileSystem.errorToString fsErr })
        |> Task.andThen
            (\_ ->
                FileSystem.move fsPermission path tmpPath
                    |> Task.mapError (\fsErr -> OverwriteFailure { path = path, error = FileSystem.errorToString fsErr })
            )
        |> Task.map (\_ -> {})


{-| Print the file's name with **no newline** and nothing after it, then flush,
so the name is on screen for as long as that file is being parsed and
formatted. `progressEnd` closes the line with the outcome. -}
progressStart : Progress -> String -> Task Error {}
progressStart progress name =
    when progress is
        Nothing ->
            Task.succeed {}

        Just stdout ->
            Stream.Log.string stdout (name ++ " ... ")


{-| Close the line `progressStart` opened, with what became of the file. -}
progressEnd : Progress -> String -> Task Error {}
progressEnd progress outcome =
    when progress is
        Nothing ->
            Task.succeed {}

        Just stdout ->
            Stream.Log.line stdout outcome


{-| Run one file's format task between the two halves of its progress line.

The error path closes the line too, and only then re-fails: a run that stops on
a bad file otherwise leaves that file's name dangling with no outcome, which
reads as "still working on it" -- exactly the ambiguity the flag exists to
remove. The full report still follows on stderr. -}
withProgress : Progress -> String -> (a -> String) -> Task Error a -> Task Error a
withProgress progress name outcomeOf task =
    progressStart progress name
        |> Task.andThen (\_ -> task)
        |> Task.andThen
            (\value ->
                progressEnd progress (outcomeOf value)
                    |> Task.map (\_ -> value)
            )
        |> Task.onError
            (\err ->
                progressEnd progress (errorOutcome err)
                    |> Task.andThen (\_ -> Task.fail err)
            )


{-| The outcome of a file that came out the other side: it either needed
rewriting or it did not. -}
rewriteOutcome : Bool -> String
rewriteOutcome wasRewritten =
    if wasRewritten then
        "reformatted"

    else
        "already formatted"


{-| The outcome of a file the formatter could not finish -- one short phrase for
the progress line; `prettifyError` has the details. -}
errorOutcome : Error -> String
errorOutcome error =
    when error is
        ParseFailure _ ->
            "parse error"

        ShowReadFailure _ ->
            "read error"

        OverwriteFailure _ ->
            "write error"

        PrettyPrintFailure _ ->
            "format error"

        CheckReparseFailed _ ->
            "format error"

        AstMismatchAfterFormat _ ->
            "format error"

        NotIdempotent _ ->
            "format error"

        FailedToFindSources _ ->
            "error"

        NothingToFormat ->
            "error"


run : Config -> Task Error String
run { fsPermission, pathToString, projectPath, outline, removeUnusedImports, progress } =
    Outline.findSourceFiles fsPermission outline projectPath
        |> Task.mapError FailedToFindSources
        |> Task.andThen
            (\files ->
                let
                    processFn { path, source } previous =
                        Task.andThen
                            (\acc ->
                                if path.extension /= "gren" then
                                    -- Probably kernel code
                                    Task.succeed acc

                                else
                                    let
                                        relPath =
                                            pathRelativeFrom projectPath path

                                        normalized =
                                            normalizeLineEndings source

                                        formatOne =
                                            when formatAndVerify removeUnusedImports relPath normalized is
                                                Err err ->
                                                    Task.fail err

                                                Ok pretty ->
                                                    -- Against the RAW bytes, deliberately: a file
                                                    -- whose only defect is its line endings has to be
                                                    -- rewritten, because `--show` would print it with
                                                    -- `\n` and in-place must land what `--show` prints.
                                                    -- Compared against the normalized text it looks
                                                    -- already-formatted and keeps its `\r`s forever.
                                                    if pretty ++ "\n" == source then
                                                        Task.succeed False

                                                    else
                                                        atomicWrite fsPermission path pretty
                                                            |> Task.map (\_ -> True)
                                    in
                                    withProgress progress (pathToString relPath) rewriteOutcome formatOne
                                        |> Task.map
                                            (\wasRewritten ->
                                                if wasRewritten then
                                                    { acc | rewritten = Array.pushLast (pathToString path) acc.rewritten }

                                                else
                                                    { acc | skipped = acc.skipped + 1 }
                                            )
                            )
                            previous

                    reportedProgress =
                        when progress is
                            Just _ ->
                                True

                            Nothing ->
                                False

                    summarize { rewritten, skipped } =
                        let
                            -- With `--show-progress` every one of these paths has
                            -- already been printed, on its own line, next to what
                            -- happened to it; listing them again would just be the
                            -- same names twice.
                            paths =
                                if not reportedProgress && Array.length rewritten > 0 then
                                    String.join "\n" rewritten ++ "\n"

                                else
                                    ""

                            rewrittenCount =
                                String.fromInt (Array.length rewritten)

                            skippedCount =
                                String.fromInt skipped
                        in
                        paths ++ rewrittenCount ++ " files reformatted, " ++ skippedCount ++ " files already formatted."
                in
                if files == [] then
                    Task.fail NothingToFormat

                else
                    Array.foldl processFn (Task.succeed { rewritten = [], skipped = 0 }) files
                        |> Task.map summarize
            )


{-| Format a single file and overwrite it in place (atomic write).
    Returns True if the file was rewritten, False if it was already formatted.
-}
formatFile : { fsPermission : FileSystem.Permission, removeUnusedImports : Bool } -> Path -> Task Error Bool
formatFile { fsPermission, removeUnusedImports } path =
    readSource fsPermission path
        |> Task.andThen
            (\source ->
                when formatAndVerify removeUnusedImports path source is
                    Err err ->
                        Task.fail err

                    Ok pretty ->
                        if pretty ++ "\n" == source then
                            Task.succeed False

                        else
                            atomicWrite fsPermission path pretty
                                |> Task.map (\_ -> True)
            )


{-| Format every file reached by the given path arguments — a directory expands
to its direct Gren source files (`expandPathToFiles`), any other path is that
file — overwriting each in place. Returns how many were rewritten vs. already
formatted. -}
formatPaths : { fsPermission : FileSystem.Permission, removeUnusedImports : Bool, progress : Progress } -> Array Path -> Task Error { rewritten : Int, skipped : Int }
formatPaths config paths =
    let
        fileConfig =
            { fsPermission = config.fsPermission
            , removeUnusedImports = config.removeUnusedImports
            }

        formatOne filePath innerTask =
            innerTask
                |> Task.andThen
                    (\counts ->
                        withProgress config.progress (Path.toPosixString filePath) rewriteOutcome (formatFile fileConfig filePath)
                            |> Task.map
                                (\wasRewritten ->
                                    if wasRewritten then
                                        { counts | rewritten = counts.rewritten + 1 }

                                    else
                                        { counts | skipped = counts.skipped + 1 }
                                )
                    )

        expandAndFormat path outerTask =
            outerTask
                |> Task.andThen
                    (\counts ->
                        expandPathToFiles config.fsPermission path
                            |> Task.andThen (\filePaths -> Array.foldl formatOne (Task.succeed counts) filePaths)
                    )
    in
    Array.foldl expandAndFormat (Task.succeed { rewritten = 0, skipped = 0 }) paths


showFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission, removeUnusedImports : Bool } -> Path -> Task Error {}
showFile { stdout, fsPermission, removeUnusedImports } path =
    readSource fsPermission path
        |> Task.andThen
            (\source ->
                when formatAndVerify removeUnusedImports path source is
                    Err err ->
                        Task.fail err

                    Ok pretty ->
                        Stream.Log.line stdout pretty
            )


{-| Like `showFile` but prints the *first* format without the idempotency guard,
so a non-idempotent first pass can be inspected. Debug aid behind `--show-first`. -}
showFirstFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission, removeUnusedImports : Bool } -> Path -> Task Error {}
showFirstFile { stdout, fsPermission, removeUnusedImports } path =
    readSource fsPermission path
        |> Task.andThen
            (\source ->
                when formatFirst removeUnusedImports path source is
                    Err err ->
                        Task.fail err

                    Ok pretty ->
                        Stream.Log.line stdout pretty
            )


preAstFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
preAstFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\source ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { ast, payload } ->
                        let
                            jsonValue =
                                Json.object
                                    [ { key = "module", value = SourceJson.encodeModule ast }
                                    , { key = "context", value = ContextJson.encodeContext payload }
                                    ]
                        in
                        Stream.Log.line stdout (Json.encode 2 jsonValue)
            )


{-| Parse a single file and print only the first parse's `Context` (the comments)
as JSON — the `--pre-ast` output without the `module`
half. Useful for confirming that two environments parse the same bytes to the
same comment positions. -}
preContextFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
preContextFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\source ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { payload } ->
                        Stream.Log.line stdout (Json.encode 2 (ContextJson.encodeContext payload))
            )


postAstFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
postAstFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\source ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { ast = ast1, payload = payload1 } ->
                        when renderModule path ast1 payload1 is
                            Err err ->
                                Task.fail err

                            Ok formatted ->
                                when parseModule CheckReparseFailed path formatted is
                                    Err err ->
                                        Task.fail err

                                    Ok { ast = ast2, payload = payload2 } ->
                                        when AstCompare.compareModules ast1 ast2 is
                                            Err explanation ->
                                                Task.fail (AstMismatchAfterFormat { path = path, explanation = explanation })

                                            Ok {} ->
                                                let
                                                    jsonValue =
                                                        Json.object
                                                            [ { key = "module", value = SourceJson.encodeModule ast2 }
                                                            , { key = "context", value = ContextJson.encodeContext payload2 }
                                                            ]
                                                in
                                                Stream.Log.line stdout (Json.encode 2 jsonValue)
            )


{-| Format a single file, verify the ASTs match, then print only the
formatted file's `Context` (the comment and whitespace stream) as JSON — the
`--post-ast` output without the `module` half. Useful for confirming that
formatting produces the expected comment/blank-line layout without the noise
of the full AST. -}
postContextFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
postContextFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\source ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { ast = ast1, payload = payload1 } ->
                        when renderModule path ast1 payload1 is
                            Err err ->
                                Task.fail err

                            Ok formatted ->
                                when parseModule CheckReparseFailed path formatted is
                                    Err err ->
                                        Task.fail err

                                    Ok { ast = ast2, payload = payload2 } ->
                                        when AstCompare.compareModules ast1 ast2 is
                                            Err explanation ->
                                                Task.fail (AstMismatchAfterFormat { path = path, explanation = explanation })

                                            Ok {} ->
                                                Stream.Log.line stdout (Json.encode 2 (ContextJson.encodeContext payload2))
            )


lptFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
lptFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\source ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { ast, payload } ->
                        when makeLogicalPrintingTree ast payload is
                            Err errString ->
                                Task.fail (PrettyPrintFailure { path = path, error = errString })

                            Ok lpt ->
                                Stream.Log.line stdout (LPTJson.lptToJson lpt)
            )


{-| Print the predicate/renderer disagreements in one file as JSON. Each entry is
a layout predicate that promised a hard break the renderer did not emit -- a
class of bug every other check is blind to, because the resulting output is
still deterministic, AST-equivalent and idempotent.
-}
auditPredicatesFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
auditPredicatesFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\source ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { ast, payload } ->
                        when makeLogicalPrintingTree ast payload is
                            Err errString ->
                                Task.fail (PrettyPrintFailure { path = path, error = errString })

                            Ok lpt ->
                                Stream.Log.line stdout
                                    (PredicateAgreement.findingsToJson (PredicateAgreement.auditLpt lpt))
            )


{-| Format the file twice and print, as JSON, which layout *decisions* differed
between the two passes -- not which bytes did.

`--show` already answers "is this a fixed point". It cannot answer "which
decision was not", and with a non-zero residual of known non-idempotent shapes
that second question is the one with a work-list behind it: a byte diff has to
be traced back to a culprit by hand, whereas a flipped decision names itself and
groups with every other finding that flipped the same one.

The two passes here are the same two `verifyReparse` runs -- render, reparse,
render the reparsed AST -- with the AST comparison left out and both Logical
Printing Trees kept. Leaving it out is deliberate: this flag is aimed at files
that are *not* fixed points, and an AST mismatch is a different bug class that
`--show` reports properly.
-}
decisionsFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
decisionsFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\source ->
                when decisionStabilityReport path source is
                    Err err ->
                        Task.fail err

                    Ok report ->
                        Stream.Log.line stdout (DecisionTrace.reportToJson report)
            )


decisionStabilityReport :
    Path
    -> String
    -> Result Error
        { bytesDiffer : Bool
        , flips : Array DecisionTrace.Flip
        , movedDecls : Array String
        , convergedFlips : Int
        , decisionCount : Int
        }
decisionStabilityReport path source =
    let
        wrapErr errString =
            PrettyPrintFailure { path = path, error = errString }

        -- The per-declaration trace and the string the whole file renders to.
        -- `renderModule` gives only the second, and the trace is the point here.
        renderPass ast payload =
            makeLogicalPrintingTree ast payload
                |> Result.mapError wrapErr
                |> Result.andThen
                    (\lpt ->
                        Result.map2
                            (\pretty decls -> { pretty = pretty, decls = decls })
                            (makePrettyResult lpt)
                            (DecisionTrace.traceDeclarations lpt)
                            |> Result.mapError wrapErr
                    )
    in
    parseModule ParseFailure path source
        |> Result.andThen (\first -> renderPass first.ast first.payload)
        |> Result.andThen
            (\pass1 ->
                parseModule CheckReparseFailed path pass1.pretty
                    |> Result.andThen (\second -> renderPass second.ast second.payload)
                    |> Result.map
                        (\pass2 ->
                            let
                                diff =
                                    DecisionTrace.diffDeclarations pass1.decls pass2.decls
                            in
                            { bytesDiffer = pass1.pretty /= pass2.pretty
                            , flips = diff.flips
                            , movedDecls = diff.movedDecls
                            , convergedFlips = diff.convergedFlips
                            , decisionCount = Array.foldl (\d acc -> acc + Array.length d.decisions) 0 pass1.decls
                            }
                        )
            )


boxFile : { stdout : Stream.Writable Bytes, fsPermission : FileSystem.Permission } -> Path -> Task Error {}
boxFile { stdout, fsPermission } path =
    readSource fsPermission path
        |> Task.andThen
            (\source ->
                when parseModule ParseFailure path source is
                    Err err ->
                        Task.fail err

                    Ok { ast, payload } ->
                        when makeLogicalPrintingTree ast payload is
                            Err errString ->
                                Task.fail (PrettyPrintFailure { path = path, error = errString })

                            Ok lpt ->
                                when lptToBoxJson lpt is
                                    Err errString ->
                                        Task.fail (PrettyPrintFailure { path = path, error = errString })

                                    Ok json ->
                                        Stream.Log.line stdout json
            )


-- TODO: add to gren-lang/node?
pathRelativeFrom : Path -> Path -> Path
pathRelativeFrom base absolute =
    let
        commonPrefix =
            findCommonPrefix 0 (Array.pushLast base.filename base.directory) absolute.directory
    in
    if commonPrefix > 0 then
        { root = ""
        , directory = Array.dropFirst commonPrefix absolute.directory
        , filename = absolute.filename
        , extension = absolute.extension
        }

    else
        absolute


findCommonPrefix : Int -> Array String -> Array String -> Int
findCommonPrefix count left right =
    when { l = Array.popFirst left, r = Array.popFirst right } is
        { l = Just { first = lFirst, rest = lRest }, r = Just { first = rFirst, rest = rRest } } ->
            if lFirst == rFirst then
                findCommonPrefix (count + 1) lRest rRest

            else
                count

        _ ->
            count


prettifyError : Error -> Report
prettifyError error =
    when error is
        FailedToFindSources fsErr ->
            Report.create
                "COULD NOT FIND SOURCE CODE"
                Nothing
                (PP.verticalBlock
                    [ PP.words "An error occured while I was searching for .gren files in this project."
                    , PP.empty
                    , PP.words "The error is:"
                    , PP.empty
                    , PP.words (ProjectOutline.outlineFindSourcesErrorToString fsErr)
                        |> PP.indent
                    ]
                )

        NothingToFormat ->
            Report.create
                "NOTHING TO FORMAT"
                Nothing
                (PP.words "I can't seem to find any files in this project."
                )

        ParseFailure { path, error = message } ->
            Report.create
                "FAILED TO PARSE"
                (Just path)
                (PP.verticalBlock (Array.map PP.text (String.split "\n" message))
                )

        PrettyPrintFailure { path, error = message } ->
            Report.create
                "FORMATTER INTERNAL ERROR. PLEASE REPORT THIS 'gren-format' BUG."
                (Just path)
                (PP.verticalBlock (Array.map PP.text (String.split "\n" message))
                )

        OverwriteFailure { path, error = message } ->
            Report.create
                "COULD NOT OVERWRITE FILE"
                (Just path)
                (PP.words message)

        AstMismatchAfterFormat { path, explanation } ->
            Report.create
                "AST MISMATCH AFTER FORMATTING"
                (Just path)
                (PP.verticalBlock
                    [ PP.words "The formatter produced output that does not have the same AST as the original. This is a bug in 'gren format'."
                    , PP.empty
                    , PP.words explanation
                    ]
                )

        NotIdempotent { path, diff } ->
            Report.create
                "FORMATTER NOT IDEMPOTENT"
                (Just path)
                (PP.verticalBlock
                    [ PP.words "Formatting the file twice produced different output. This is a bug in 'gren format'."
                    , PP.empty
                    , PP.verticalBlock (Array.map PP.text (String.split "\n" diff))
                    ]
                )

        ShowReadFailure { path, error = message } ->
            Report.create
                "COULD NOT READ FILE"
                (Just path)
                (PP.words message)

        CheckReparseFailed { path, error = message } ->
            Report.create
                "COULD NOT PARSE FORMATTED OUTPUT"
                (Just path)
                (PP.verticalBlock (Array.map PP.text (String.split "\n" message))
                )
