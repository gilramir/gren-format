module Version exposing (version)

{-| The version string `gren-format --version` prints.

**Generated by `build.sh` from `package.json`'s `"version"` — do not edit, and do
not bump it here.** `npm version <patch|minor|major>` is the only place a version
is bumped; `build.sh` regenerates this file from `package.json` before every
build, so a hand edit is overwritten on the next one.

It is committed rather than ignored so that a plain `gren make Main` works in a
fresh clone; `build.sh` rewrites it only when the version actually changed.

-}


{-| The current version, as it appears in `package.json`.
-}
version : String
version =
    "1.1.0"
