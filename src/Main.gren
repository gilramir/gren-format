module Main exposing (main)

{-| Standalone `gren-format` CLI built on `Argparse.Program.runRootWithContext`
(rootless — invoked directly as `gren-format [flags]`, no command word).

With no arguments it formats every source file in the project in place (requires
`gren.json` in the current directory). The remaining flags are single-file
inspection/debug aids.
-}

import Argparse.Parser as AP
import Argparse.PrettyPrinter as PP
import Argparse.Program as Program
import Cli.Report as Report
import Dict
import FileSystem
import FileSystem.Path as Path exposing (Path)
import Format
import Init
import Node
import Stream.Log
import Task exposing (Task)
import Terminal
import Terminal.ProjectOutline as ProjectOutline
import Version


type alias FormatFlags =
    { files : Array Path
    , diff : Bool
    , removeUnusedImports : Bool
    , showProgress : Bool
    , show : Maybe Path
    , showFirst : Maybe Path
    , preAst : Maybe Path
    , preContext : Maybe Path
    , postAst : Maybe Path
    , postContext : Maybe Path
    , lpt : Maybe Path
    , rt : Maybe Path
    , box : Maybe Path
    , auditPredicates : Maybe Path
    , decisions : Maybe Path
    , version : Bool
    }


type alias Context =
    { fs : FileSystem.Permission
    , useColor : Bool
    }


command : AP.Command (Array Path) FormatFlags FormatFlags
command =
    { word = ""
    , arguments =
        AP.zeroOrMoreArgs
            { value = AP.pathParser
            , help = "Gren source file or directory to pretty-print in place"
            }
    , flags =
        AP.initFlags
            (\diff removeUnusedImports showProgress show showFirst preAst preContext postAst postContext lpt rt box auditPredicates decisions version ->
                { files = []
                , diff = diff
                , removeUnusedImports = removeUnusedImports
                , showProgress = showProgress
                , show = show
                , showFirst = showFirst
                , preAst = preAst
                , preContext = preContext
                , postAst = postAst
                , postContext = postContext
                , lpt = lpt
                , rt = rt
                , box = box
                , auditPredicates = auditPredicates
                , decisions = decisions
                , version = version
                }
            )
            |> AP.toggle (AP.Both { long = "diff", short = "d" }) "Print a unified diff of what formatting would change, without modifying any file"
            |> AP.toggle (AP.LongOnly "remove-unused-imports") "Remove unused imports while formatting"
            |> AP.toggle (AP.LongOnly "show-progress") "Print each file as it is formatted, then its outcome on the same line"
            |> AP.flag (AP.LongOnly "show") AP.pathParser "Parse and pretty-print a single file to stdout without modifying it"
            |> AP.flag (AP.LongOnly "show-first") AP.pathParser "Like --show but print the FIRST format without the idempotency guard (debug: inspect a non-idempotent first pass)"
            |> AP.flag (AP.LongOnly "pre-ast") AP.pathParser "Parse a single file and print its AST as JSON to stdout"
            |> AP.flag (AP.LongOnly "pre-context") AP.pathParser "Parse a single file and print its parse Context (comments) as JSON to stdout"
            |> AP.flag (AP.LongOnly "post-ast") AP.pathParser "Parse and format a file, verify the ASTs match, then print the formatted file's AST as JSON to stdout"
            |> AP.flag (AP.LongOnly "post-context") AP.pathParser "Parse and format a file, verify the ASTs match, then print the formatted file's parse Context as JSON to stdout"
            |> AP.flag (AP.LongOnly "lpt") AP.pathParser "Parse a single file and print its Logical Printing Tree as JSON to stdout"
            |> AP.flag (AP.LongOnly "rt") AP.pathParser "Parse a single file and print its render tree as JSON to stdout -- the Logical Printing Tree as the renderer sees it, with the source positions taken off"
            |> AP.flag (AP.LongOnly "box") AP.pathParser "Parse a single file and print the Box tree (the render plan) as JSON to stdout"
            |> AP.flag (AP.LongOnly "audit-predicates") AP.pathParser "Parse a single file and print, as JSON, every layout predicate that claims a hard break the renderer does not emit"
            |> AP.flag (AP.LongOnly "decisions") AP.pathParser "Format a single file twice and print, as JSON, which layout decisions differed between the two passes"
            |> AP.toggle (AP.LongOnly "version") "Print the gren-format version and exit"
    , commonDescription = Nothing
    , summary = "Format Gren source code."
    , example = PP.empty
    , builder = \args flags -> { flags | files = args }
    }


main : Node.SimpleProgram a
main =
    Program.runRootWithContext
        { name = "gren-format"
        , version = Version.version
        , command = command
        , init =
            \_env toProgram ->
                Init.await FileSystem.initialize <| \fsPermission ->
                Init.await Terminal.initialize <| \terminalConfig ->
                Init.awaitTask Node.getEnvironmentVariables <| \envVars ->
                    let
                        -- Color only when stderr/stdout is an interactive terminal
                        -- and the user hasn't set NO_COLOR (https://no-color.org).
                        useColor =
                            terminalConfig /= Nothing && not (Dict.member "NO_COLOR" envVars)
                    in
                    toProgram { fs = fsPermission, useColor = useColor }
        , onCommand = onCommand
        }


onCommand : Node.Environment -> Context -> FormatFlags -> Task Program.Failure {}
onCommand env context flags =
    let
        fileConfig =
            { stdout = env.stdout
            , fsPermission = context.fs
            }

        showConfig =
            { stdout = env.stdout
            , fsPermission = context.fs
            , removeUnusedImports = flags.removeUnusedImports
            }

        anyFlagSet =
            flags.show /= Nothing
                || flags.showFirst /= Nothing
                || flags.preAst /= Nothing
                || flags.preContext /= Nothing
                || flags.postAst /= Nothing
                || flags.postContext /= Nothing
                || flags.lpt /= Nothing
                || flags.rt /= Nothing
                || flags.box /= Nothing
                || flags.auditPredicates /= Nothing
                || flags.decisions /= Nothing

        -- Progress is a property of the modes that walk several files; the
        -- single-file inspection flags ignore it.
        progress =
            progressStream env flags

        diffConfig =
            { stdout = env.stdout
            , fsPermission = context.fs
            , removeUnusedImports = flags.removeUnusedImports
            , progress = progress
            }
    in
    if flags.version then
        -- `Argparse.Program` also intercepts a *leading* `--version` before the
        -- parser ever runs; declaring it as a real flag as well is what puts it
        -- in `--help` and lets it work in any position. Both paths print this.
        Stream.Log.line env.stdout Version.version
            |> Task.map (\_ -> {})

    else if flags.diff && anyFlagSet then
        Task.fail (Program.ExitMessage "Cannot combine --diff with the single-file inspection flags. Use --help for options.")

    else if not (Array.isEmpty flags.files) then
        if anyFlagSet then
            Task.fail (Program.ExitMessage "Cannot combine file path arguments with flags. Use --help for options.")

        else if flags.diff then
            Format.diffPaths diffConfig flags.files
                |> Task.mapError (\err -> Program.ExitMessage (reportToString context.useColor (Format.prettifyError err)))

        else
            Format.formatPaths { fsPermission = context.fs, removeUnusedImports = flags.removeUnusedImports, progress = progress } flags.files
                |> Task.mapError (\err -> Program.ExitMessage (reportToString context.useColor (Format.prettifyError err)))
                |> Task.andThen
                    (\{ rewritten, skipped } ->
                        Stream.Log.line env.stdout
                            (String.fromInt rewritten ++ " files reformatted, " ++ String.fromInt skipped ++ " files already formatted.")
                    )
                |> Task.map (\_ -> {})

    else if flags.diff then
        projectTask env context flags Format.diffProject

    else
        let
            -- The single-file debug flags, in priority order. Each is a
            -- `Maybe (Task …)` — set when its flag carries a path — and the
            -- first one set wins; if none is, format the whole project.
            singleFileOp =
                Array.foldl
                    (\maybeTask acc ->
                        when acc is
                            Just _ ->
                                acc

                            Nothing ->
                                maybeTask
                    )
                    Nothing
                    [ Maybe.map (Format.showFile showConfig) flags.show
                    , Maybe.map (Format.showFirstFile showConfig) flags.showFirst
                    , Maybe.map (Format.preAstFile fileConfig) flags.preAst
                    , Maybe.map (Format.preContextFile fileConfig) flags.preContext
                    , Maybe.map (Format.postAstFile fileConfig) flags.postAst
                    , Maybe.map (Format.postContextFile fileConfig) flags.postContext
                    , Maybe.map (Format.lptFile fileConfig) flags.lpt
                    , Maybe.map (Format.rtFile fileConfig) flags.rt
                    , Maybe.map (Format.boxFile fileConfig) flags.box
                    , Maybe.map (Format.auditPredicatesFile fileConfig) flags.auditPredicates
                    , Maybe.map (Format.decisionsFile fileConfig) flags.decisions
                    ]
        in
        when singleFileOp is
            Just task ->
                runFileOp context.useColor task

            Nothing ->
                formatProject env context flags


{-| Where per-file progress goes for the modes that walk several files.

Under `--diff` it goes to stderr rather than stdout: stdout is then carrying a
unified diff that has to stay pipeable into `patch`, and progress lines mixed
into it would not be. -}
progressStream : Node.Environment -> FormatFlags -> Format.Progress
progressStream env flags =
    if not flags.showProgress then
        Nothing

    else if flags.diff then
        Just env.stderr

    else
        Just env.stdout


{-| The shared front half of the whole-project modes: locate the project's
`gren.json`, build the run's `Format.Config`, and hand it to whichever of them
was asked for -- `Format.run` to rewrite the files, `Format.diffProject` to
print what rewriting them would change. -}
projectTask : Node.Environment -> Context -> FormatFlags -> (Format.Config -> Task Format.Error a) -> Task Program.Failure a
projectTask env context flags op =
    ProjectOutline.readProjectOutline context.fs
        |> Task.mapError
            (\err ->
                when err is
                    ProjectOutline.ReadProjectOutlineNoProject _ ->
                        Program.ExitMessage "Could not find a gren.json in this directory or any parent directory. Run `gren-format -h` to see all the options"

                    _ ->
                        Program.ExitMessage (reportToString context.useColor (ProjectOutline.prettifyProjectOutlineError err))
            )
        |> Task.andThen
            (\{ projectPath, outline } ->
                op
                    { stdout = env.stdout
                    , fsPermission = context.fs
                    , pathToString = Path.toPosixString
                    , projectPath = projectPath
                    , outline = outline
                    , removeUnusedImports = flags.removeUnusedImports
                    , progress = progressStream env flags
                    }
                    |> Task.mapError (\err -> Program.ExitMessage (reportToString context.useColor (Format.prettifyError err)))
            )


formatProject : Node.Environment -> Context -> FormatFlags -> Task Program.Failure {}
formatProject env context flags =
    projectTask env context flags Format.run
        |> Task.andThen (\summary -> Stream.Log.line env.stdout summary)
        |> Task.map (\_ -> {})


{-| Run a single-file operation: success exits 0, a `Format.Error` becomes a
rendered report on stderr (exit 1, via the runner's failed-task path). -}
runFileOp : Bool -> Task Format.Error {} -> Task Program.Failure {}
runFileOp useColor task =
    task
        |> Task.mapError (\err -> Program.ExitMessage (reportToString useColor (Format.prettifyError err)))


reportToString : Bool -> Report.Report -> String
reportToString useColor report =
    Report.toString (Report.Terminal { useColor = useColor }) Path.toPosixString report
