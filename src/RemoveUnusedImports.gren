module RemoveUnusedImports exposing (removeUnusedImports)

import Array.Builder as Builder
import Compiler.Ast.Source as Src
import Compiler.Parse.Context as Ctx
import Compiler.SourcePosition exposing (Located)
import ShiftPositions
import String


-- ENTRY POINT


{-| Remove imports not referenced anywhere in the module body.

Open-expose imports (exposing (..)) are always kept — we can't analyze them
without knowing the imported module's exports.  Explicit-expose imports are
kept conservatively: if any exposed name appears anywhere in the code
(even shadowed), the import is kept. The same conservatism applies to any
individual `Type(..)` in an explicit list: it also exposes the type's
constructors, and a bare constructor name elsewhere in the file can't be
attributed to this import versus some other module's same-named constructor,
so it's always kept.

A kept import's exposing list is still trimmed name-by-name: any exposed
name that fails that same "used anywhere" check is dropped from the list
even though the import itself survives (see `trimExposing`). A comment
trailing a dropped name on that name's own source row is attached to it —
same rule as a trailing comment on a whole removed import — and is dropped
along with it. A comment on its own line (before or after the name, on a
different row) is not touched; it wasn't written on the name's line, so
nothing here can say it belongs to that name rather than to something
else nearby.

An import that's an exact duplicate of an earlier import already kept --
same module, same alias, and the same exposing list, byte-for-byte as
written -- is treated the same way an unused import is: removed outright,
or replaced with a placeholder if that would otherwise orphan a leading
comment. Only the first occurrence survives. Two imports of the same
module that differ in any way (different alias, different exposing list)
are judged independently and are never merged. Within a single import's
own exposing list, a name repeated more than once collapses to its first
occurrence the same way, once usage has already dropped every unused
entry.

Comments whose start row falls within a removed import's row range are
also removed — a comment trailing the import on its own line, or nested
inside its exposing list. A comment on its own line *directly above* the
import (no blank line) is different: rather than orphan it, the import is
replaced with a single placeholder comment (`-- removed import Foo`, or
`-- removed import Foo as F` when aliased) on the row it used to start at,
and the leading comment is left exactly where it is. Deleting the import
outright there would otherwise leave that comment sitting directly above
whichever import ends up in its place once the row-gap below closes,
silently reattaching it to something the author never wrote it about.

Removing rows also means everything after them needs renumbering — nothing
downstream (`Formatter.Logical.Comments`, `Formatter.Logical.SortSymbols`)
tolerates a stale, pre-edit row gap; see `ShiftPositions` for that half of
the work.
-}
removeUnusedImports : Src.Module -> Ctx.Context -> { module_ : Src.Module, context : Ctx.Context }
removeUnusedImports modAst ctx =
    let
        refs =
            refsFromModule modAst

        comments =
            Builder.toArray ctx.comments

        scan =
            classifyImports refs comments modAst.imports

        keptComments =
            comments
                |> Array.keepIf (\c -> not (commentIsInsideAny scan.removedRanges c))
                |> Array.keepIf (\c -> not (Array.member c.start.row scan.trimmedExposedRows))

        chargedCuts =
            chargeOverlappingComments keptComments scan.cuts

        shield =
            docShield modAst { scan | cuts = chargedCuts }

        cuts =
            when shield is
                Just s ->
                    s.cuts

                Nothing ->
                    chargedCuts

        deltaAt =
            deltaAtRow cuts

        newImports =
            Array.map (\locImport -> ShiftPositions.shiftImport (deltaAt locImport.start.row) locImport) scan.keptImports

        survivingComments =
            Array.map (\c -> ShiftPositions.shiftLocated (deltaAt c.start.row) c) keptComments

        -- Each placeholder is built at its import's ORIGINAL (unshifted)
        -- start row (see `placeholderComment`), so it still needs the same
        -- per-row shift as any other surviving comment -- using its own
        -- original row is correct even though that row is also this
        -- placeholder's own cutoff: `deltaAtRow` excludes a cut at its own
        -- cutoffRow (strict `<`), so this never double-shifts the
        -- placeholder by its own freed rows, only by earlier ones.
        shiftedPlaceholders =
            scan.placeholders
                |> Array.map (\c -> ShiftPositions.shiftLocated (deltaAt c.start.row) c)

        newComments =
            (survivingComments ++ shiftedPlaceholders)
                |> Array.sortWith compareCommentPosition

        totalDelta =
            -(Array.foldl (\cut acc -> acc + cut.freedRows) 0 cuts)

        newDocs =
            when shield is
                Just s ->
                    Just (ShiftPositions.shiftLocated (deltaAt s.doc.start.row) s.doc)

                Nothing ->
                    modAst.docs

        shifted =
            ShiftPositions.shiftDeclarations totalDelta modAst
    in
    { module_ = { modAst
                    | imports = newImports
                    , docs = newDocs
                    , values = shifted.values
                    , unions = shifted.unions
                    , aliases = shifted.aliases
                    , effects = shifted.effects
                    , binops = shifted.binops
                }
    , context = { ctx | comments = Builder.fromArray newComments }
    }


compareCommentPosition : Located Ctx.Comment -> Located Ctx.Comment -> Order
compareCommentPosition a b =
    when compare a.start.row b.start.row is
        EQ ->
            compare a.start.col b.start.col

        other ->
            other

-- IMPORT CLASSIFICATION
--
-- Decide, for each import in source order, whether it's kept, removed
-- outright, or replaced with a placeholder comment -- and compute the row
-- deltas that decision implies for everything after it.


{-| One row-range that collapsed: `cutoffRow` is the removed import's own
original last row: any position whose original row is greater is shifted by
`freedRows` (in addition to any earlier cuts). `freedRows` is the import's
own height for a plain removal, or that height minus one when a placeholder
comment survives in its place (the placeholder still occupies its first
row) -- and minus again for any of those rows a surviving comment is still
sitting on (`chargeOverlappingComments`). `startRow` is the import's own
first row, which is what those rows are counted from. -}
type alias Cut =
    { startRow : Int
    , cutoffRow : Int
    , freedRows : Int
    }


{-| The content of an import that determines whether it's an exact
duplicate of another -- position is deliberately excluded, so two imports
at different rows with the same module/alias/exposing compare equal. -}
type alias ImportIdentity =
    { module_ : String
    , alias : Maybe String
    , exposed : Array String
    }


importIdentity : Src.Import -> ImportIdentity
importIdentity import_ =
    { module_ = import_.module_.value
    , alias = import_.alias
    , exposed =
        when import_.expose is
            Src.Open ->
                [ "..open.." ]

            Src.Explicit exposed ->
                Array.map exposedIdentity exposed
    }


{-| A string identity for one `Exposed` entry -- used both to detect
duplicate whole imports (`ImportIdentity`) and to dedupe repeated names
within a single import's own exposing list (`dedupeExposed`). Ignores
position; a bare name and `Type(..)` are deliberately distinct identities
since they expose different things. -}
exposedIdentity : Src.Exposed -> String
exposedIdentity exposed =
    when exposed is
        Src.ExposedLower locName ->
            "lower:" ++ locName.value

        Src.ExposedUpper { name, privacy } ->
            when privacy is
                Src.Public ->
                    "upper-open:" ++ name.value

                Src.Private ->
                    "upper:" ++ name.value

        Src.ExposedOperator locOp ->
            "operator:" ++ locOp.value


deltaAtRow : Array Cut -> Int -> Int
deltaAtRow cuts row =
    -(Array.foldl
        (\cut acc ->
            if cut.cutoffRow < row then
                acc + cut.freedRows

            else
                acc
        )
        0
        cuts
     )


type alias ScanState =
    { hasPendingLeading : Bool
    , runStartRow : Int
    , lastRow : Int
    , justSawImportEndingAt : Maybe Int
    , keptImports : Array (Located Src.Import)
    , removedImports : Array (Located Src.Import)
    , removedRanges : Array { startRow : Int, endRow : Int }
    , cuts : Array Cut
    , placeholders : Array (Located Ctx.Comment)
    , trimmedExposedRows : Array Int
    , seenIdentities : Array ImportIdentity
    }


type RegionItem
    = ImportItem (Located Src.Import)
    | CommentItem (Located Ctx.Comment)


{-| Walk every import, in source order, merged with the comments that sit at
or before the last import's row (comments after that belong to whatever
declaration follows the imports, never to an import) -- see
`RegionItem`/`mergedRegion`. Comments and imports both carry a real,
original row/col, so a single row-ordered walk correctly interleaves them
regardless of how `Array.Builder` happened to accumulate `ctx.comments`. -}
classifyImports : Refs -> Array (Located Ctx.Comment) -> Array (Located Src.Import) -> ScanState
classifyImports refs comments imports =
    Array.foldl (classifyStep refs comments) initScanState (mergedRegion imports comments)


initScanState : ScanState
initScanState =
    { hasPendingLeading = False
    , runStartRow = 0
    , lastRow = 0
    , justSawImportEndingAt = Nothing
    , keptImports = []
    , removedImports = []
    , removedRanges = []
    , cuts = []
    , placeholders = []
    , trimmedExposedRows = []
    , seenIdentities = []
    }


mergedRegion : Array (Located Src.Import) -> Array (Located Ctx.Comment) -> Array RegionItem
mergedRegion imports comments =
    let
        inScope =
            when Array.last imports is
                Just lastImport ->
                    Array.keepIf (\c -> c.start.row <= lastImport.end.row) comments

                Nothing ->
                    []
    in
    (Array.map ImportItem imports ++ Array.map CommentItem inScope)
        |> Array.sortWith compareRegionItem


{-| Row order, with an import sorting before a same-row comment (its own
trailing comment) -- the only way two items ever share a row. -}
compareRegionItem : RegionItem -> RegionItem -> Order
compareRegionItem a b =
    when compare (regionItemRow a) (regionItemRow b) is
        EQ ->
            compare (regionItemRank a) (regionItemRank b)

        other ->
            other


regionItemRow : RegionItem -> Int
regionItemRow item =
    when item is
        ImportItem locImport ->
            locImport.start.row

        CommentItem locComment ->
            locComment.start.row


regionItemRank : RegionItem -> Int
regionItemRank item =
    when item is
        ImportItem _ ->
            0

        CommentItem _ ->
            1


classifyStep : Refs -> Array (Located Ctx.Comment) -> RegionItem -> ScanState -> ScanState
classifyStep refs comments item state =
    when item is
        CommentItem c ->
            if not state.hasPendingLeading && state.justSawImportEndingAt == Just c.start.row then
                -- Trailing comment of the import just processed -- not a
                -- leading-comment candidate for whatever import comes next.
                -- Already accounted for by `commentIsInsideAny` if that
                -- import turns out to be removed.
                { state | justSawImportEndingAt = Nothing, lastRow = c.end.row }

            else if state.hasPendingLeading && state.lastRow + 1 == c.start.row then
                -- Contiguous continuation of the run building up.
                { state | lastRow = c.end.row, justSawImportEndingAt = Nothing }

            else
                -- Either nothing was pending, or a gap broke the previous
                -- run -- start a fresh one. (A stale, non-contiguous
                -- `pendingLeading` is not tracked by value here; if it's
                -- never claimed by an import it survives as an ordinary
                -- comment via the ordinary `commentIsInsideAny` filter in
                -- `removeUnusedImports`, unaffected either way.)
                { state
                    | hasPendingLeading = True
                    , runStartRow = c.start.row
                    , lastRow = c.end.row
                    , justSawImportEndingAt = Nothing
                }

        ImportItem locImport ->
            let
                -- Measured against the row the import's glued lead opens on
                -- rather than the keyword's row, because an own-line run above
                -- a glued lead leads the whole thing and needs the same
                -- placeholder as one sitting on the keyword's row.
                --
                -- The run has to be asked where it STARTS, not just where it
                -- ends: the walk sees the glued lead as an ordinary comment and
                -- carries the run down through it, so a run that is nothing but
                -- the glued lead ends inside the range too, and has nothing
                -- above to orphan.
                hasLeadingRun =
                    state.hasPendingLeading
                        && state.runStartRow < chainStart
                        && state.lastRow + 1 >= chainStart

                used =
                    importIsUsed refs locImport.value

                chainEnd =
                    trailingChainEndRow comments locImport

                chainStart =
                    gluedLeadStartRow comments locImport

                height =
                    chainEnd - chainStart + 1

                withReset extra =
                    { extra
                        | hasPendingLeading = False
                        , lastRow = locImport.end.row
                        , justSawImportEndingAt = Just locImport.end.row
                    }

                identity =
                    importIdentity locImport.value

                isDuplicate =
                    used && Array.member identity state.seenIdentities
            in
            if used && not isDuplicate then
                let
                    trimmed =
                        trimExposing refs locImport
                in
                withReset
                    { state
                        | keptImports = Array.pushLast trimmed.import_ state.keptImports
                        , trimmedExposedRows = state.trimmedExposedRows ++ trimmed.droppedExposedRows
                        , seenIdentities = Array.pushLast identity state.seenIdentities
                    }

            else if not hasLeadingRun then
                withReset
                    { state
                        | removedImports = Array.pushLast locImport state.removedImports
                        , removedRanges = Array.pushLast { startRow = chainStart, endRow = chainEnd } state.removedRanges
                        , cuts = Array.pushLast { startRow = chainStart, cutoffRow = chainEnd, freedRows = height } state.cuts
                    }

            else
                withReset
                    { state
                        | removedImports = Array.pushLast locImport state.removedImports
                        , removedRanges = Array.pushLast { startRow = chainStart, endRow = chainEnd } state.removedRanges
                        , cuts = Array.pushLast { startRow = chainStart, cutoffRow = chainEnd, freedRows = height - 1 } state.cuts
                        , placeholders = Array.pushLast (placeholderComment chainStart locImport) state.placeholders
                    }


{-| The module's own doc slot is parsed BEFORE its imports
(`Compiler.Parse.Module`: header → exports → docs → imports → declarations),
so a `{-| ... -}` is only the *first declaration's* doc because an import
stands between it and the header. Remove every import and that same comment
reparses as the MODULE's doc — the declaration silently loses its
documentation, and the file means something different from what the author
wrote. Nothing about the output's spelling can prevent it: the parser skips
line and block comments while looking for the docs slot, so a
`-- removed import Foo` placeholder does not shield it (verified).

So when removal would empty the import list, the module has no doc of its
own, and the first declaration has one, this hands the docs slot a
`{-| removed import Foo -}` of its own, naming the last import removed. The
declaration's doc then stays the declaration's, and the reason it must stay
is written down where the next reader will find it. The doc is a real
`Src.Module.docs` entry rather than a comment in the context, because that
is where the renderer reads a module doc from — and because the reparsed
output must AST-compare equal to what this function returns.

Only ever reached in a module that has no doc comment of its own, which for
an exposed package module is already a docs-generation failure; in practice
this is an application or internal module.

Returns the doc plus the adjusted `cuts` — the doc occupies one row that
would otherwise have been freed, exactly like `placeholderComment`. It takes
the last removed import's own start row, or the row below it when that row
already carries a placeholder (`freedRows` then goes one lower still, which
is negative for a one-row import whose placeholder already took its row: the
file grows by the row the doc needs, and `deltaAtRow` shifts everything
below down to make it). -}
docShield : Src.Module -> ScanState -> Maybe { doc : Located String, cuts : Array Cut }
docShield modAst scan =
    if
        Array.isEmpty scan.keptImports
            && modAst.docs == Nothing
            && firstDeclarationHasDocs modAst
    then
        when Array.last scan.removedImports is
            Just lastRemoved ->
                let
                    placeholderTookItsRow =
                        Array.any
                            (\c -> c.start.row == lastRemoved.start.row)
                            scan.placeholders

                    row =
                        if placeholderTookItsRow then
                            lastRemoved.start.row + 1

                        else
                            lastRemoved.start.row

                    aliasSuffix =
                        when lastRemoved.value.alias is
                            Just alias_ ->
                                " as " ++ alias_

                            Nothing ->
                                ""

                    text =
                        " removed import " ++ lastRemoved.value.module_.value ++ aliasSuffix ++ " "

                    start =
                        { row = row, col = lastRemoved.start.col }
                in
                Just
                    { doc =
                        { start = start
                        , end = { row = row, col = start.col + 5 + String.count text }
                        , value = text
                        }
                    , cuts = spendOneRow scan.cuts
                    }

            Nothing ->
                Nothing

    else
        Nothing


{-| A removed import does not free a row that something else is still
standing on. A block comment that opens on an earlier row and closes on one
of the import's own rows -- `{- a` / `b -} import Foo`, the glued-lead shape
-- survives the removal (its start row is outside the import's range) and
goes on occupying every row it spans. Freeing those rows anyway shifts
whatever follows UP INTO the middle of that comment, and the formatter then
renders the two in the order their collided rows imply rather than the order
they were written in: `{- a b -}` above `-- c` in the source comes back out
with `-- c` on top. A comment that changed places with another is exactly the
class this transform must not produce, and no later pass can undo it -- by
then the rows say what they say.

So each cut is charged for the rows of its own range that a surviving
comment still covers, and frees only the rest. The overlap is a MAXIMUM
rather than a sum: comments cannot interleave, so at most one of them reaches
into any given cut, and taking the deepest reach counts each shared row once.

Only a comment that STARTS before the import can overlap it. One starting
inside the import's range is deleted along with it (`commentIsInsideAny`),
so it holds no rows -- which is why this is charged against the surviving
comments rather than all of them. -}
chargeOverlappingComments : Array (Located Ctx.Comment) -> Array Cut -> Array Cut
chargeOverlappingComments keptComments cuts =
    Array.map
        (\cut ->
            let
                overlap =
                    keptComments
                        |> Array.map
                            (\c ->
                                if c.start.row < cut.startRow && c.end.row >= cut.startRow then
                                    min c.end.row cut.cutoffRow - cut.startRow + 1

                                else
                                    0
                            )
                        |> Array.maximum
                        |> Maybe.withDefault 0
            in
            { cut | freedRows = max 0 (cut.freedRows - overlap) }
        )
        cuts


{-| One row of the last cut is now occupied by the shield doc, so that cut
frees one row fewer. The last cut is the last removed import's: imports are
classified in source order, and no two end on the same row. -}
spendOneRow : Array Cut -> Array Cut
spendOneRow cuts =
    when Array.popLast cuts is
        Just { last, initial } ->
            Array.pushLast { last | freedRows = last.freedRows - 1 } initial

        Nothing ->
            cuts


{-| Does the declaration that comes FIRST in the file carry a doc comment?
That is the only position where a doc comment can slide into the module's
docs slot once the imports are gone — a doc on any later declaration has a
declaration in front of it and stays put.

Every declaration kind counts, including the ones that can never carry a doc
(`binops`): an infix declaration standing first is exactly what stops a
later declaration's doc from reaching the header. -}
firstDeclarationHasDocs : Src.Module -> Bool
firstDeclarationHasDocs modAst =
    let
        ports =
            when modAst.effects is
                Src.Ports portDecls ->
                    portDecls

                _ ->
                    []

        docBearing =
            Array.map declarationMarker modAst.values
                ++ Array.map declarationMarker modAst.unions
                ++ Array.map declarationMarker modAst.aliases
                ++ Array.map declarationMarker ports
                ++ Array.map (\locInfix -> { row = locInfix.start.row, hasDocs = False }) modAst.binops
    in
    docBearing
        |> Array.sortBy .row
        |> Array.first
        |> Maybe.map .hasDocs
        |> Maybe.withDefault False


{-| A declaration's sort key: the row it starts at — its doc comment's row
when it has one, since that is what sits closest to the header. -}
declarationMarker : Src.ModuleDeclaration a -> { row : Int, hasDocs : Bool }
declarationMarker locDecl =
    when locDecl.value.docs is
        Just locDoc ->
            { row = locDoc.start.row, hasDocs = True }

        Nothing ->
            { row = locDecl.start.row, hasDocs = False }


{-| The last row a removed import takes with it: its own end row, extended
through its **trailing comment chain**.

A comment trailing an import can itself be trailed, on the row the one before
it closes on -- `import Foo {- a` / `b -} -- c` (docs/sorting.md, "Trailing a
comment that trails a name"). Every link is written about the import, so
every link goes when the import does. Reading only the import's own end row
kept the links below it, and a link that survives lands directly above
whichever import follows and becomes ITS leading comment -- silently
reattached to something the author never wrote it about, which is the very
thing the `-- removed import Foo` placeholder exists to prevent for the
comments ABOVE an import. (Found by `gen-random.py`'s remove-unused-imports
oracle, seeds 41000355 / 41000367.)

A chain continues only onto the row its previous link CLOSES on. A comment
one row further down starts a new run: it leads whatever comes next, is not
about this import, and is left alone -- the placeholder rule takes it from
there. Each step moves strictly down, so the walk terminates. -}
trailingChainEndRow : Array (Located Ctx.Comment) -> Located Src.Import -> Int
trailingChainEndRow comments locImport =
    extendChainFrom comments locImport.end.row


{-| The first row a removed import takes with it: its own start row, extended
BACKWARDS through a comment glued in front of the `import` keyword.

`{- a -} import Foo` is one row, so the comment's start row already falls
inside the import's range and goes with it. Write the same comment across two
rows -- `{- a` / `b -} import Foo` -- and its start row falls outside, so it
survived, and after the run sorted it came to rest directly above a different
import, reading as that import's lead. Same `LeadsInline` role, opposite fate,
decided by nothing but how many rows the comment happened to span. Now both go
with the import they are glued to.

Walks backwards the way `trailingChainEndRow` walks forwards, and for the same
reason: `{- a` / `b -} {- c` / `d -} import Foo` is a run of glued leads, each
closing on the row the next one opens on. Each step moves strictly up, so the
walk terminates. -}
gluedLeadStartRow : Array (Located Ctx.Comment) -> Located Src.Import -> Int
gluedLeadStartRow comments locImport =
    extendGlueBackFrom comments locImport.start.row


extendGlueBackFrom : Array (Located Ctx.Comment) -> Int -> Int
extendGlueBackFrom comments row =
    let
        reachesBack =
            comments
                |> Array.keepIf (\c -> c.end.row == row && c.start.row < row)
                |> Array.map (\c -> c.start.row)
                |> Array.minimum
    in
    when reachesBack is
        Just earlierRow ->
            extendGlueBackFrom comments earlierRow

        Nothing ->
            row


extendChainFrom : Array (Located Ctx.Comment) -> Int -> Int
extendChainFrom comments row =
    let
        reachesFurther =
            comments
                |> Array.keepIf (\c -> c.start.row == row && c.end.row > row)
                |> Array.map (\c -> c.end.row)
                |> Array.maximum
    in
    when reachesFurther is
        Just furtherRow ->
            extendChainFrom comments furtherRow

        Nothing ->
            row


{-| `-- removed import Foo`, or `-- removed import Foo as F` when the import
had an alias -- never the exposing list. Positioned on the FIRST row removed:
the import's own start row, or the row its glued lead opens on when it had
one. On the keyword's row instead it left the row above it free, and the
import below shifted up onto the placeholder's own row. Unshifted -- the
caller shifts it like any other surviving comment, keyed by this row. -}
placeholderComment : Int -> Located Src.Import -> Located Ctx.Comment
placeholderComment row locImport =
    let
        aliasSuffix =
            when locImport.value.alias is
                Just alias_ ->
                    " as " ++ alias_

                Nothing ->
                    ""

        text =
            " removed import " ++ locImport.value.module_.value ++ aliasSuffix

        startPos =
            { row = row, col = locImport.start.col }

        endPos =
            { row = row, col = locImport.start.col + 2 + String.count text }
    in
    { start = startPos, end = endPos, value = Ctx.Line text }


-- COMMENT FILTERING


commentIsInsideAny : Array { startRow : Int, endRow : Int } -> Located Ctx.Comment -> Bool
commentIsInsideAny removedRanges locComment =
    Array.any
        (\range ->
            locComment.start.row >= range.startRow
                && locComment.start.row <= range.endRow
        )
        removedRanges

-- EXPOSING LIST TRIMMING
--
-- A kept import can still carry exposed names nothing in the file uses --
-- e.g. `import Dict exposing (get, insert)` when only `get` appears. Trim
-- those out too, the same conservative name-by-name rule `exposedIsUsed`
-- already applies at the whole-import level. If every entry gets trimmed,
-- `Array.keepIf` yields an empty array and the pretty printer already
-- renders an import with no exposed names as a bare `import Foo` (no
-- `exposing` clause at all).
--
-- A trailing comment on the same source row as a trimmed-away name is
-- attached to that name -- the only thing else on the row -- and is dropped
-- with it (see `trimmedExposedRows` in `removeUnusedImports`). A comment on
-- its own row (before or after the name) is left alone; nothing here can
-- say which nearby name it belongs to once the name it may have been about
-- is gone, so it survives rather than risk deleting a comment about
-- something else.
--
-- A name repeated in the same exposing list (`exposing (get, get)`) is
-- deduped after the used/unused filter: the first occurrence is kept, any
-- later occurrence of that same name is dropped exactly like an unused one
-- (including the same trailing-comment-on-its-row handling).


trimExposing : Refs -> Located Src.Import -> { import_ : Located Src.Import, droppedExposedRows : Array Int }
trimExposing refs locImport =
    let
        import_ =
            locImport.value
    in
    when import_.expose is
        Src.Open ->
            { import_ = locImport, droppedExposedRows = [] }

        Src.Explicit exposed ->
            let
                unused =
                    Array.keepIf (\e -> not (exposedIsUsed refs e)) exposed

                used =
                    Array.keepIf (exposedIsUsed refs) exposed

                deduped =
                    dedupeExposed used
            in
            { import_ = { locImport | value = { import_ | expose = Src.Explicit deduped.kept } }
            , droppedExposedRows = Array.map exposedRow (unused ++ deduped.dropped)
            }


dedupeExposed : Array Src.Exposed -> { kept : Array Src.Exposed, dropped : Array Src.Exposed }
dedupeExposed exposedList =
    Array.foldl
        (\e acc ->
            let
                identity =
                    exposedIdentity e
            in
            if Array.member identity acc.seenIdentities then
                { acc | dropped = Array.pushLast e acc.dropped }

            else
                { acc
                    | kept = Array.pushLast e acc.kept
                    , seenIdentities = Array.pushLast identity acc.seenIdentities
                }
        )
        { kept = [], dropped = [], seenIdentities = [] }
        exposedList
        |> (\acc -> { kept = acc.kept, dropped = acc.dropped })


-- The source row an `Exposed` entry's name starts on -- used to find a
-- trailing comment on that same row when the entry is dropped.
exposedRow : Src.Exposed -> Int
exposedRow exposed =
    when exposed is
        Src.ExposedLower locName ->
            locName.start.row

        Src.ExposedUpper { name } ->
            name.start.row

        Src.ExposedOperator locOp ->
            locOp.start.row


-- IMPORT USAGE CHECK


importIsUsed : Refs -> Src.Import -> Bool
importIsUsed refs import_ =
    let
        qualifier =
            when import_.alias is
                Just alias_ ->
                    alias_

                Nothing ->
                    import_.module_.value
    in
    when import_.expose is
        Src.Open ->
            True

        Src.Explicit exposed ->
            Array.member qualifier refs.qualifiers
                || Array.any (exposedIsUsed refs) exposed


exposedIsUsed : Refs -> Src.Exposed -> Bool
exposedIsUsed refs exposed =
    when exposed is
        Src.ExposedLower locName ->
            Array.member locName.value refs.names

        Src.ExposedUpper { name, privacy } ->
            when privacy is
                -- `Type(..)` also exposes the type's constructors, so an
                -- unqualified name used anywhere in the file could be one of
                -- them -- we have no way to resolve which module a bare
                -- constructor name came from, so treat the import as used
                -- unconditionally rather than risk removing it.
                Src.Public ->
                    True

                Src.Private ->
                    Array.member name.value refs.names

        Src.ExposedOperator locOp ->
            Array.member locOp.value refs.operators

-- REFERENCE COLLECTION
--
-- refs.qualifiers  — module qualifier strings from VarQual, PCtorQual, TTypeQual
-- refs.names       — unqualified names from Var, PCtor, TType
-- refs.operators   — operator symbols from Operator and Binops


type alias Refs =
    { qualifiers : Array String
    , names : Array String
    , operators : Array String
    }


emptyRefs : Refs
emptyRefs =
    { qualifiers = []
    , names = []
    , operators = []
    }


mergeRefs : Refs -> Refs -> Refs
mergeRefs a b =
    { qualifiers = Array.append a.qualifiers b.qualifiers
    , names = Array.append a.names b.names
    , operators = Array.append a.operators b.operators
    }


refsFromModule : Src.Module -> Refs
refsFromModule modAst =
    Array.foldl (\locDecl acc -> mergeRefs acc (refsFromValue locDecl.value.value)) emptyRefs modAst.values
        |> mergeRefs (Array.foldl (\locDecl acc -> mergeRefs acc (refsFromUnion locDecl.value.value)) emptyRefs modAst.unions)
        |> mergeRefs (Array.foldl (\locDecl acc -> mergeRefs acc (refsFromAlias locDecl.value.value)) emptyRefs modAst.aliases)
        |> mergeRefs (refsFromEffects modAst.effects)


refsFromValue : Src.Value -> Refs
refsFromValue value =
    let
        argRefs =
            Array.foldl (\p acc -> mergeRefs acc (refsFromPattern p)) emptyRefs value.args

        sigRefs =
            when value.signature is
                Nothing ->
                    emptyRefs

                Just { type_ } ->
                    refsFromType type_
    in
    argRefs
        |> mergeRefs (refsFromExpression value.body)
        |> mergeRefs sigRefs


refsFromExpression : Src.Expression -> Refs
refsFromExpression expr =
    when expr.value is
        Src.CharLiteral _ ->
            emptyRefs

        Src.StringLiteral _ ->
            emptyRefs

        Src.NumberLiteral _ ->
            emptyRefs

        Src.Var { name } ->
            { emptyRefs | names = [ name ] }

        Src.VarQual { qualifier } ->
            { emptyRefs | qualifiers = [ qualifier ] }

        Src.ArrayLiteral exprs ->
            Array.foldl (\e acc -> mergeRefs acc (refsFromExpression e)) emptyRefs exprs

        Src.Record fields ->
            Array.foldl (\f acc -> mergeRefs acc (refsFromExpression f.value)) emptyRefs fields

        Src.Update { record, newValues } ->
            Array.foldl
                (\f acc -> mergeRefs acc (refsFromExpression f.value))
                (refsFromExpression record)
                newValues

        Src.Operator op ->
            { emptyRefs | operators = [ op ] }

        Src.Negate e ->
            refsFromExpression e

        Src.Binops { left, operator, right } ->
            refsFromExpression left
                |> mergeRefs { emptyRefs | operators = [ operator.value ] }
                |> mergeRefs (refsFromExpression right)

        Src.Lambda { patterns, body } ->
            Array.foldl (\p acc -> mergeRefs acc (refsFromPattern p)) emptyRefs patterns
                |> mergeRefs (refsFromExpression body)

        Src.Call { fn, args } ->
            Array.foldl (\a acc -> mergeRefs acc (refsFromExpression a)) (refsFromExpression fn) args

        Src.Let { defs, body } ->
            Array.foldl (\locDef acc -> mergeRefs acc (refsFromDef locDef.value)) emptyRefs defs
                |> mergeRefs (refsFromExpression body)

        Src.If { branches, elseBranch } ->
            Array.foldl
                (\b acc ->
                    acc
                        |> mergeRefs (refsFromExpression b.test)
                        |> mergeRefs (refsFromExpression b.body)
                )
                emptyRefs
                branches
                |> mergeRefs (refsFromExpression elseBranch)

        Src.When { expression, branches } ->
            Array.foldl
                (\b acc ->
                    acc
                        |> mergeRefs (refsFromPattern b.pattern)
                        |> mergeRefs (refsFromExpression b.body)
                )
                (refsFromExpression expression)
                branches

        Src.Accessor _ ->
            emptyRefs

        Src.Access { expression } ->
            refsFromExpression expression

        Src.Parens e ->
            refsFromExpression e


refsFromDef : Src.Def -> Refs
refsFromDef def =
    when def is
        Src.Define { args, body, typeSignature } ->
            let
                argRefs =
                    Array.foldl (\p acc -> mergeRefs acc (refsFromPattern p)) emptyRefs args

                sigRefs =
                    when typeSignature is
                        Nothing ->
                            emptyRefs

                        Just typ ->
                            refsFromType typ
            in
            argRefs
                |> mergeRefs (refsFromExpression body)
                |> mergeRefs sigRefs

        Src.Destruct { pattern, body } ->
            mergeRefs (refsFromPattern pattern) (refsFromExpression body)


refsFromPattern : Src.Pattern -> Refs
refsFromPattern pat =
    when pat.value is
        Src.PAnything _ ->
            emptyRefs

        Src.PVar _ ->
            emptyRefs

        Src.PRecord fields ->
            Array.foldl (\f acc -> mergeRefs acc (refsFromMaybePattern f.pattern)) emptyRefs fields

        Src.PAlias { pattern } ->
            refsFromPattern pattern

        Src.PCtor { name, arg } ->
            mergeRefs { emptyRefs | names = [ name.value ] } (refsFromMaybePattern arg)

        Src.PCtorQual { module_, arg } ->
            mergeRefs { emptyRefs | qualifiers = [ module_ ] } (refsFromMaybePattern arg)

        Src.PArray pats ->
            Array.foldl (\p acc -> mergeRefs acc (refsFromPattern p)) emptyRefs pats

        Src.PChr _ ->
            emptyRefs

        Src.PStr _ ->
            emptyRefs

        Src.PInt _ ->
            emptyRefs


{-| A constructor argument (`PCtor`/`PCtorQual`) and a record-pattern field
(`PRecordField`) can each carry a nested sub-pattern -- `Just (Zebra.Foo n)`,
`{ thing = Just (Zebra.Foo n) }` -- so a qualifier or name referenced only
there must still be seen, or its import looks unused and gets deleted. -}
refsFromMaybePattern : Maybe Src.Pattern -> Refs
refsFromMaybePattern maybePattern =
    when maybePattern is
        Just p ->
            refsFromPattern p

        Nothing ->
            emptyRefs


refsFromType : Src.Type -> Refs
refsFromType typ =
    when typ.value is
        Src.TLambda { from, to } ->
            mergeRefs (refsFromType from) (refsFromType to)

        Src.TVar _ ->
            emptyRefs

        Src.TType { name, args } ->
            Array.foldl (\a acc -> mergeRefs acc (refsFromType a)) { emptyRefs | names = [ name.value ] } args

        Src.TTypeQual { qualifier, args } ->
            Array.foldl (\a acc -> mergeRefs acc (refsFromType a)) { emptyRefs | qualifiers = [ qualifier ] } args

        Src.TRecord { fields } ->
            Array.foldl (\f acc -> mergeRefs acc (refsFromType f.signature)) emptyRefs fields

        Src.TParens t ->
            refsFromType t


refsFromAlias : Src.Alias -> Refs
refsFromAlias alias_ =
    refsFromType alias_.type_


refsFromUnion : Src.Union -> Refs
refsFromUnion union =
    Array.foldl
        (\locVariant acc ->
            when locVariant.value.payload is
                Nothing ->
                    acc

                Just typ ->
                    mergeRefs acc (refsFromType typ)
        )
        emptyRefs
        union.variants


refsFromEffects : Src.Effects -> Refs
refsFromEffects effects =
    when effects is
        Src.NoEffects ->
            emptyRefs

        Src.Ports ports ->
            Array.foldl
                (\locDecl acc -> mergeRefs acc (refsFromType locDecl.value.value.signature))
                emptyRefs
                ports

        Src.Manager _ ->
            emptyRefs
