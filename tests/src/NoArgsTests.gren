module NoArgsTests exposing (noArgsSuite)

{-| CLI integration tests for running `gren-format` with no arguments at all
(and `--help` / `--version`).

@docs noArgsSuite
-}

import Expect
import FileSystem.Path as Path
import Support exposing (Perms, makeScratch, removeScratch)
import Task
import Test.Runner.UnitNode as U


{-| -}
noArgsSuite : Perms -> U.Suite
noArgsSuite perms =
    U.suite
        { name = "NoArgs"
        , setUpSuite = Support.locateApp perms
        , tearDownSuite = U.noTearDown
        , setUp = makeScratch perms
        , tearDown = removeScratch perms
        , tests =
            [ U.test "no gren.json exits nonzero with helpful message" <|
                \s ->
                    Support.runApp perms s.appPath { cwd = Just (Path.toPosixString s.dir) } []
                        |> Task.map
                            (\r ->
                                Expect.all
                                    [ \_ -> Expect.notEqual 0 r.exitCode
                                    , \_ -> Support.expectContains "Could not find a gren.json" r.stderr
                                    ]
                                    {}
                            )
            , U.test "help flag lists --show and --lpt" <|
                \s ->
                    Support.runApp perms s.appPath { cwd = Nothing } [ "--help" ]
                        |> Task.map
                            (\r ->
                                Expect.all
                                    [ \_ -> Expect.equal 0 r.exitCode
                                    , \_ -> Support.expectContains "--show" r.stdout
                                    , \_ -> Support.expectContains "--lpt" r.stdout
                                    , \_ -> Support.expectContains "--version" r.stdout
                                    ]
                                    {}
                            )
            , U.test "version flag prints a version and exits 0" <|
                \s ->
                    Support.runApp perms s.appPath { cwd = Nothing } [ "--version" ]
                        |> Task.map
                            (\r ->
                                Expect.all
                                    [ \_ -> Expect.equal 0 r.exitCode
                                    , \_ -> Expect.notEqual "" (String.trim r.stdout)
                                    , \_ -> Support.expectContains "." r.stdout
                                    ]
                                    {}
                            )

            -- `Argparse.Program` only intercepts a *leading* `--version`; the
            -- declared flag is what makes it work anywhere on the line, and
            -- short-circuit the mode it was combined with.
            , U.test "version flag works after another flag, with identical output" <|
                \s ->
                    Support.runApp perms s.appPath { cwd = Nothing } [ "--version" ]
                        |> Task.andThen
                            (\leading ->
                                Support.runApp perms s.appPath { cwd = Nothing } [ "--diff", "--version" ]
                                    |> Task.map
                                        (\trailing ->
                                            Expect.all
                                                [ \_ -> Expect.equal 0 trailing.exitCode
                                                , \_ -> Expect.equal leading.stdout trailing.stdout
                                                ]
                                                {}
                                        )
                            )
            ]
        }
