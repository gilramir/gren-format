module NoArgsFormatTests exposing (noArgsFormatSuite)

{-| CLI integration tests for running `gren-format` with no arguments when a
`gren.json` project is present — formats every source file in place.

This mode reads its sources through `Outline.findSourceFiles`, not through
`Format.readSource`, so anything the read boundary is supposed to do has to be
checked here separately — CRLF normalization was missing from exactly this
path, and `--show` passed on the very same bytes.

The CRLF case reads its module from
`testfiles/CrlfProject/DocBodyAndMultilineString.gren` rather than building one
inline, because the trigger is narrower than "has a doc comment": several
hand-written CRLF modules with multi-row doc comments pass with or without the
fix. That file is a mechanically reduced real failure (from
`fuzz-project.py --trial 0`), kept in the repo with LF endings and converted to
CRLF by the test.

@docs noArgsFormatSuite
-}

import Expect
import FileSystem.Path as Path
import Support exposing (Perms, dirtyHello, makeScratch, readBack, removeScratch)
import Task
import Test.Runner.UnitNode as U


{-| -}
noArgsFormatSuite : Perms -> U.Suite
noArgsFormatSuite perms =
    U.suite
        { name = "NoArgsFormat"
        , setUpSuite = Support.locateApp perms
        , tearDownSuite = U.noTearDown
        , setUp = makeScratch perms
        , tearDown = removeScratch perms
        , tests =
            [ U.test "formats project files in place" <|
                \s ->
                    let
                        srcFile =
                            Path.append (Path.fromPosixString "src/Hello.gren") s.dir
                    in
                    Support.makeProject perms s.dir dirtyHello
                        |> Task.andThen (\_ -> Support.runApp perms s.appPath { cwd = Just (Path.toPosixString s.dir) } [])
                        |> Task.andThen (\r -> readBack perms srcFile |> Task.map (\after -> { r = r, after = after }))
                        |> Task.map
                            (\res ->
                                Expect.all
                                    [ \_ -> Expect.equal 0 res.r.exitCode
                                    , \_ -> Support.expectContains "Hello.gren" res.r.stdout
                                    , \_ -> Support.expectContains "\n\n\n" res.after
                                    ]
                                    {}
                            )
            , U.test "summary reports reformatted count" <|
                \s ->
                    Support.makeProject perms s.dir dirtyHello
                        |> Task.andThen (\_ -> Support.runApp perms s.appPath { cwd = Just (Path.toPosixString s.dir) } [])
                        |> Task.map (\r -> Support.expectContains "1 files reformatted" r.stdout)
            , U.test "summary reports 0 reformatted when files already formatted" <|
                \s ->
                    Support.makeProject perms s.dir dirtyHello
                        |> Task.andThen (\_ -> Support.runApp perms s.appPath { cwd = Just (Path.toPosixString s.dir) } [])
                        |> Task.andThen (\_ -> Support.runApp perms s.appPath { cwd = Just (Path.toPosixString s.dir) } [])
                        |> Task.map (\r -> Support.expectContains "0 files reformatted" r.stdout)
            , U.test "a CRLF project formats in place like any other, and the run after it is a no-op" <|
                \s ->
                    let
                        srcFile =
                            Path.append (Path.fromPosixString "src/Hello.gren") s.dir

                        runOnce =
                            Support.runApp perms s.appPath { cwd = Just (Path.toPosixString s.dir) } []
                    in
                    readBack perms (Path.fromPosixString "testfiles/CrlfProject/DocBodyAndMultilineString.gren")
                        |> Task.andThen (\lf -> Support.makeProject perms s.dir (String.replace "\n" "\r\n" lf))
                        |> Task.andThen (\_ -> runOnce)
                        |> Task.andThen (\first -> runOnce |> Task.map (\second -> { first = first, second = second }))
                        |> Task.andThen (\rs -> readBack perms srcFile |> Task.map (\after -> { rs = rs, after = after }))
                        |> Task.map
                            (\res ->
                                Expect.all
                                    [ \_ -> Expect.equal 0 res.rs.first.exitCode
                                    , \_ -> Expect.equal False (String.contains "\r" res.after)
                                    , \_ -> Support.expectContains "0 files reformatted" res.rs.second.stdout
                                    ]
                                    {}
                            )
            ]
        }
