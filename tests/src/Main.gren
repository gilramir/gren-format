module Main exposing ( main )

{-| CLI integration tests for the `gren-format` binary — a Gren port of the old
`test_cli.py`, built on `gilramir/gren-unit-node`.

Each Python `TestCase` class becomes a `U.suite`, one per file (see
`NoArgsTests`, `ShowFlagTests`, `JsonFlagsTests`, `PositionalTests`,
`NoArgsFormatTests`, `RemoveUnusedImportsTests`). Shared fixtures/helpers
(spawning the app, scratch dirs, `--show`/JSON assertions) live in
`Support`. The app binary is located once per suite in `setUpSuite`; suites
that need scratch space make a fresh temp dir per test in `setUp` and
remove it in `tearDown` (the `with TemporaryDirectory()` replacement,
cleaned up even when a test fails). Run it like the unittest CLI:

    ./run_tests.sh                 # build app + tests, run all
    node app -v                    # verbose: per-test status + timing
    node app 'AllFlag.*'           # glob-select by qualified name
    node app --junit-xml out.xml   # machine-readable results
-}

import ChildProcess
import FileSystem
import Init
import Node
import Test.Runner.UnitNode as U
import NoArgsTests exposing (noArgsSuite)
import ShowFlagTests exposing (showFlagSuite)
import JsonFlagsTests exposing (jsonFlagsSuite)
import PositionalTests exposing (positionalSuite)
import NoArgsFormatTests exposing (noArgsFormatSuite)
import RemoveUnusedImportsTests exposing (removeUnusedImportsFlagSuite)


main : Node.SimpleProgram a
main =
    U.runWith
        { name = "gren-format-cli-tests"
        , version = "1.0.0"
        , init =
            \done ->
                Init.await FileSystem.initialize <| \fs ->
                Init.await ChildProcess.initialize <| \cp ->
                    done { fs = fs, childProcess = cp }
        , globalSetUp = U.noFixture
        , globalTearDown = U.noTearDown
        , suites =
            \perms ->
                [ noArgsSuite perms
                , showFlagSuite perms
                , jsonFlagsSuite perms
                , positionalSuite perms
                , noArgsFormatSuite perms
                , removeUnusedImportsFlagSuite perms
                ]
        }
