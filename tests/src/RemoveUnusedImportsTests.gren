module RemoveUnusedImportsTests exposing (removeUnusedImportsFlagSuite)

{-| CLI integration tests for `--remove-unused-imports`.

`--remove-unused-imports` deletes an unused `import` and renumbers every row
after it so nothing downstream keeps a stale gap. An import with a comment
directly (no blank line) above it is a special case: rather than orphan
that comment, the import becomes a single `-- removed import Foo`
placeholder instead of disappearing outright. An import that's kept because
some but not all of its exposed names are used still has the unused ones
dropped from its exposing list.

Each case is a fixture pair under `testfiles/RemoveUnusedImports/`:
`<Name>.dirty.gren` is run through `--remove-unused-imports --show`, and the
output must match `<Name>.formatted.gren` byte-for-byte.

@docs removeUnusedImportsFlagSuite
-}

import Expect
import FileSystem.Path as Path
import Task
import Test.Runner.UnitNode as U
import Support exposing (Perms, Scratch)


{-| -}
removeUnusedImportsFlagSuite : Perms -> U.Suite
removeUnusedImportsFlagSuite perms =
    U.suite
        { name = "RemoveUnusedImportsFlag"
        , setUpSuite = Support.locateApp perms
        , tearDownSuite = U.noTearDown
        , setUp = Support.makeScratch perms
        , tearDown = Support.removeScratch perms
        , tests =
            [ U.test "plain removal closes the gap so the surrounding imports sort together" <| \s ->
                expectRemoveUnusedImports perms s "PlainRemoval"
            , U.test "a leading line comment survives as a placeholder instead of being orphaned" <| \s ->
                expectRemoveUnusedImports perms s "LineComment"
            , U.test "a leading block comment gets the same placeholder treatment as a line comment" <| \s ->
                expectRemoveUnusedImports perms s "BlockComment"
            , U.test "the placeholder for an aliased import includes the alias" <| \s ->
                expectRemoveUnusedImports perms s "Aliased"
            , U.test "a placeholder is still an own-line comment, so it keeps the imports on either side of it in separate sort groups" <| \s ->
                expectRemoveUnusedImports perms s "GroupsSeparate"
            , U.test "an effect module's `where { ... }` header positions survive the shift untouched" <| \s ->
                expectRemoveUnusedImports perms s "EffectModule"
            , U.test "a per-declaration doc comment after the cut is shifted along with its declaration" <| \s ->
                expectRemoveUnusedImports perms s "DeclarationDocComment"
            , U.test "an exposed Type(..) is kept even when the type name itself is never referenced" <| \s ->
                expectRemoveUnusedImports perms s "OpenType"
            , U.test "an unused name is dropped from a kept import's exposing list, while an import whose every exposed name is unused is removed entirely" <| \s ->
                expectRemoveUnusedImports perms s "PartialExposingTrim"
            , U.test "nested lambda/when/let content after the cut is shifted correctly" <| \s ->
                expectRemoveUnusedImports perms s "NestedContent"
            ]
        }


{-| Read `testfiles/RemoveUnusedImports/<fixtureBase>.dirty.gren`, run it
through `--remove-unused-imports --show`, and compare against the sibling
`.formatted.gren` fixture. -}
expectRemoveUnusedImports : Perms -> Scratch -> String -> Task.Task String Expect.Expectation
expectRemoveUnusedImports perms s fixtureBase =
    let
        file =
            Path.append (Path.fromPosixString "Fixture.gren") s.dir

        fixturePath extension =
            Path.fromPosixString ("testfiles/RemoveUnusedImports/" ++ fixtureBase ++ extension)
    in
    Support.readBack perms (fixturePath ".dirty.gren")
        |> Task.andThen (\dirty -> Support.writeText perms file dirty)
        |> Task.andThen (\_ -> Support.runApp perms s.appPath { cwd = Nothing } [ "--remove-unused-imports", "--show", Path.toPosixString file ])
        |> Task.andThen
            (\r ->
                Support.readBack perms (fixturePath ".formatted.gren")
                    |> Task.map
                        (\expected ->
                            Expect.all
                                [ \_ -> Expect.equal 0 r.exitCode
                                , \_ -> Expect.equal expected r.stdout
                                ]
                                {}
                        )
            )
