module JsonFlagsTests exposing (jsonFlagsSuite)

{-| CLI integration tests for the JSON debug flags: `--pre-ast`,
`--pre-context`, `--post-ast`, `--post-context`, `--lpt`, `--rt`, `--box`,
`--decisions`.

@docs jsonFlagsSuite
-}

import Expect
import Support exposing (Perms, RunResult, helloFixture)
import Task
import Test.Runner.UnitNode as U


{-| -}
jsonFlagsSuite : Perms -> U.Suite
jsonFlagsSuite perms =
    U.suite
        { name = "JsonFlags"
        , setUpSuite = Support.locateApp perms
        , tearDownSuite = U.noTearDown
        , setUp = \appPath -> Task.succeed appPath
        , tearDown = U.noTearDown
        , tests =
            [ U.test "pre-ast outputs json with module + context" <| \appPath ->
                runJson perms appPath "--pre-ast"
                    |> Task.map (\r -> jsonOk r (Support.expectJsonHasFields [ "module", "context" ] r.stdout))
            , U.test "pre-context outputs valid json" <| \appPath ->
                runJson perms appPath "--pre-context"
                    |> Task.map (\r -> jsonOk r (Support.expectJsonValid r.stdout))
            , U.test "post-ast outputs json with module" <| \appPath ->
                runJson perms appPath "--post-ast"
                    |> Task.map (\r -> jsonOk r (Support.expectJsonHasFields [ "module" ] r.stdout))
            , U.test "post-context outputs valid json" <| \appPath ->
                runJson perms appPath "--post-context"
                    |> Task.map (\r -> jsonOk r (Support.expectJsonValid r.stdout))
            , U.test "lpt outputs valid json" <| \appPath ->
                runJson perms appPath "--lpt"
                    |> Task.map (\r -> jsonOk r (Support.expectJsonValid r.stdout))
            , U.test "rt outputs json with type, flags and children" <| \appPath ->
                runJson perms appPath "--rt"
                    |> Task.map (\r -> jsonOk r (Support.expectJsonHasFields [ "type", "flags", "children" ] r.stdout))
            , U.test "rt carries no source positions, where lpt does" <| \appPath ->
                -- The stage barrier, asserted from outside: `RenderShape` has no
                -- `Located` to print. Checking only that `--rt` lacks `startRow`
                -- would pass on empty output, so the same fixture's `--lpt` has to
                -- show one -- that is what makes the absence mean something.
                runJson perms appPath "--lpt"
                    |> Task.andThen
                        (\lptResult ->
                            runJson perms appPath "--rt"
                                |> Task.map
                                    (\rtResult ->
                                        Expect.all
                                            [ \_ -> Expect.equal 0 lptResult.exitCode
                                            , \_ -> Expect.equal 0 rtResult.exitCode
                                            , \_ -> Support.expectContains "startRow" lptResult.stdout
                                            , \_ -> Support.expectNotContains "startRow" rtResult.stdout
                                            ]
                                            {}
                                    )
                        )
            , U.test "box outputs a json array" <| \appPath ->
                runJson perms appPath "--box"
                    |> Task.map (\r -> jsonOk r (Support.expectJsonArray r.stdout))
            , U.test "decisions reports a stable fixture as unmoved" <| \appPath ->
                runJson perms appPath "--decisions"
                    |> Task.map
                        (\r ->
                            jsonOk r
                                (Support.expectJsonHasFields
                                    [ "bytesDiffer", "unexplained", "decisionCount", "convergedFlips", "movedDecls", "flips" ]
                                    r.stdout
                                )
                        )
            ]
        }


runJson : Perms -> String -> String -> Task.Task String RunResult
runJson perms appPath flag =
    Support.runApp perms appPath { cwd = Nothing } [ flag, helloFixture ]


jsonOk : RunResult -> Expect.Expectation -> Expect.Expectation
jsonOk r jsonExpectation =
    Expect.all
        [ \_ -> Expect.equal 0 r.exitCode
        , \_ -> jsonExpectation
        ]
        {}
